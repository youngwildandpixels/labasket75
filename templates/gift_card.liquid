<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- assign gift_card_value = gift_card.initial_value | money -%}
  <title>{{ 'gift_cards.issued.title' | t: value: gift_card_value, shop: shop.name }}</title>
  {{ 'base.css' | asset_url | stylesheet_tag }}
</head>
<body>
  <div class="container" style="padding: var(--space-16) 0; text-align: center;">
    <h1>{{ shop.name }}</h1>
    <p style="margin: var(--space-6) 0; font-size: var(--font-size-h2); font-weight: var(--font-weight-bold);">
      {{ gift_card.initial_value | money }}
    </p>
    <p style="font-family: monospace; font-size: 24px; letter-spacing: 4px; margin: var(--space-6) 0;">
      {{ gift_card.code | format_code }}
    </p>
    {%- if gift_card.enabled == false or gift_card.expired -%}
      <p style="color: var(--color-promo);">{{ 'gift_cards.issued.expired' | t }}</p>
    {%- endif -%}
  </div>
</body>
</html>
