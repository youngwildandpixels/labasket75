{%- comment -%} Page 404 — non trouvée {%- endcomment -%}
<section class="error-404">
  <div class="error-404__inner container">
    <p class="error-404__code">404</p>
    <h1 class="error-404__title">Page introuvable</h1>
    <p class="error-404__text">
      Désolé, la page que vous cherchez n'existe pas ou a été déplacée.
    </p>
    <a href="{{ routes.root_url }}" class="error-404__cta">Retour à l'accueil</a>
  </div>
</section>

<style>
  .error-404 {
    padding: var(--space-16) 0;
    text-align: center;
  }

  .error-404__code {
    font-size: clamp(96px, 18vw, 220px);
    font-weight: var(--font-weight-bold);
    line-height: 0.9;
    letter-spacing: -4px;
    color: var(--color-gray-200);
    margin: 0 0 var(--space-4);
  }

  .error-404__title {
    font-size: var(--font-size-display);
    font-weight: var(--font-weight-bold);
    line-height: 1.0;
    letter-spacing: -1px;
    text-transform: uppercase;
    margin: 0 0 var(--space-4);
  }

  .error-404__text {
    font-size: var(--font-size-body);
    color: var(--color-gray-500);
    max-width: 480px;
    margin: 0 auto var(--space-6);
  }

  .error-404__cta {
    display: inline-block;
    background: var(--color-black);
    color: var(--color-white);
    border: 1.5px solid var(--color-black);
    padding: var(--space-3) var(--space-6);
    border-radius: 9999px;
    font-weight: var(--font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 1px;
    font-size: var(--font-size-small);
  }

  @media (max-width: 768px) {
    .error-404__title { font-size: 32px; letter-spacing: -0.5px; }
  }
</style>
