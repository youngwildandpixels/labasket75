{%- comment -%}
  Paramètres :
  - product : objet product Shopify
  - show_vendor : boolean
  - show_quick_add : boolean (pill "Achat express" en hover)
  - show_secondary_image : boolean (affiche la 2e image en hover)
  - lazy : boolean (lazy-load image)
{%- endcomment -%}
{%- liquid
  assign has_sale = false
  if product.compare_at_price > product.price
    assign has_sale = true
  endif

  assign secondary_image = blank
  if show_secondary_image and product.images.size > 1
    assign secondary_image = product.images[1]
  endif
-%}
<article class="product-card">
  <a href="{{ product.url }}" class="product-card__link">
    <div class="product-card__media{% if secondary_image != blank %} product-card__media--has-secondary{% endif %}">
      {%- if has_sale -%}
        <span class="badge badge--promo">PROMO</span>
      {%- endif -%}
      {%- if product.featured_image != blank -%}
        <img
          src="{{ product.featured_image | image_url: width: 600 }}"
          srcset="{{ product.featured_image | image_url: width: 400 }} 400w, {{ product.featured_image | image_url: width: 600 }} 600w"
          sizes="(max-width: 768px) 50vw, 25vw"
          alt="{{ product.featured_image.alt | escape }}"
          loading="{{ lazy | default: 'lazy' }}"
          width="600"
          height="545"
          class="product-card__img product-card__img--primary"
        >
        {%- if secondary_image != blank -%}
          <img
            src="{{ secondary_image | image_url: width: 600 }}"
            srcset="{{ secondary_image | image_url: width: 400 }} 400w, {{ secondary_image | image_url: width: 600 }} 600w"
            sizes="(max-width: 768px) 50vw, 25vw"
            alt="{{ secondary_image.alt | escape }}"
            loading="lazy"
            width="600"
            height="545"
            class="product-card__img product-card__img--secondary"
          >
        {%- endif -%}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'product-card__img product-card__img--placeholder' }}
      {%- endif -%}
    </div>
    <div class="product-card__info">
      {%- if show_vendor and product.vendor != blank -%}
        <p class="product-card__brand">{{ product.vendor }}</p>
      {%- endif -%}
      <p class="product-card__name">{{ product.title }}</p>
      <div class="product-card__prices">
        <span class="product-card__price{% if has_sale %} product-card__price--sale{% endif %}">
          {{ product.price | money_without_trailing_zeros }}
        </span>
        {%- if has_sale -%}
          <span class="product-card__price product-card__price--compare">
            {{ product.compare_at_price | money_without_trailing_zeros }}
          </span>
        {%- endif -%}
      </div>
    </div>
  </a>
  {%- if show_quick_add -%}
    {%- assign quick_variant = product.selected_or_first_available_variant -%}
    {%- liquid
      assign size_option_position = 0
      for option in product.options_with_values
        assign option_name = option.name | downcase
        if option_name contains 'taille' or option_name contains 'size' or option_name contains 'pointure'
          assign size_option_position = option.position
        endif
      endfor
    -%}
    <form method="post" action="{{ routes.cart_add_url }}" class="product-card__quick-add" data-product-card-quick-add>
      <input type="hidden" name="quantity" value="1">
      {%- if product.has_only_default_variant -%}
        <input type="hidden" name="id" value="{{ quick_variant.id }}">
      {%- endif -%}
      <button
        type="{% if product.has_only_default_variant %}submit{% else %}button{% endif %}"
        class="product-card__quick-add-btn"
        aria-label="{% if product.has_only_default_variant %}Ajouter {{ product.title | escape }} au panier{% else %}Choisir une taille pour {{ product.title | escape }}{% endif %}"
        aria-expanded="false"
        {% unless quick_variant.available %}disabled{% endunless %}
        {% unless product.has_only_default_variant %}data-quick-add-toggle{% endunless %}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 01-8 0"/>
        </svg>
      </button>
      {%- unless product.has_only_default_variant -%}
        <div class="product-card__quick-modal" data-quick-add-panel aria-hidden="true">
          <button type="button" class="product-card__quick-backdrop" data-quick-add-close aria-label="Fermer"></button>
          <div class="product-card__quick-dialog" role="dialog" aria-modal="true" aria-label="Choisir une taille">
            <button type="button" class="product-card__quick-close" data-quick-add-close aria-label="Fermer">
              <svg width="16" height="16" viewBox="0 0 18 18" aria-hidden="true">
                <path d="M4 4l10 10M14 4L4 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/>
              </svg>
            </button>
            <div class="product-card__quick-head">
              {%- if product.vendor != blank -%}
                <p class="product-card__quick-vendor">{{ product.vendor }}</p>
              {%- endif -%}
              <p class="product-card__quick-title">{{ product.title }}</p>
              <span class="product-card__quick-subtitle">Choisir une taille</span>
            </div>
            <div class="product-card__quick-sizes">
              {%- for variant in product.variants -%}
                {%- liquid
                  assign variant_size_label = variant.title
                  if size_option_position == 1
                    assign variant_size_label = variant.option1
                  elsif size_option_position == 2
                    assign variant_size_label = variant.option2
                  elsif size_option_position == 3
                    assign variant_size_label = variant.option3
                  endif
                -%}
                <button
                  type="submit"
                  name="id"
                  value="{{ variant.id }}"
                  class="product-card__quick-size"
                  {% unless variant.available %}disabled{% endunless %}
                >
                  <span class="product-card__quick-size-label">{{ variant_size_label }}</span>
                  <span class="product-card__quick-size-prices">
                    {%- if variant.compare_at_price > variant.price -%}
                      <span class="product-card__quick-size-compare">{{ variant.compare_at_price | money_without_trailing_zeros }}</span>
                    {%- endif -%}
                    <span>{{ variant.price | money_without_trailing_zeros }}</span>
                  </span>
                </button>
              {%- endfor -%}
            </div>
          </div>
        </div>
      {%- endunless -%}
    </form>
  {%- endif -%}
</article>
