{% doc %}
  @description
    Renders a two-line delivery badge when a variant has fast delivery enabled.

  @param {product} product - Product whose variant delivery settings are checked.
  @param {string} [class] - Optional extra CSS class.
{% enddoc %}

{%- liquid
  assign show_badge = false
  for variant in product.variants
    if variant.metafields.custom.delivery_24_48h.value == true
      assign show_badge = true
      break
    endif
  endfor

  assign badge_class = 'delivery-badge'
  if class != blank
    assign badge_class = badge_class | append: ' ' | append: class
  endif
-%}

{%- if show_badge -%}
  <span class="{{ badge_class }}">
    <span class="delivery-badge__heading">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
        <path d="M13.5 2 4 14h7l-1 8L20 10h-7l.5-8Z"/>
      </svg>
      {{ 'products.product.fast_delivery_short' | t }}
    </span>
    <span class="delivery-badge__detail">{{ 'products.product.fast_delivery_sizes' | t }}</span>
  </span>
{%- endif -%}
