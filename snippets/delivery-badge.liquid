{% doc %}
  @description
    Renders a fast delivery badge for available products tagged for 24-48h shipping.

  @param {product} product - Product used to determine availability and tags.
  @param {string} [class] - Optional extra CSS class.
  @param {string} [label] - Optional badge label.
{% enddoc %}

{%- liquid
  assign badge_product = product
  assign show_badge = false
  assign badge_label = label | default: 'Livraison 24-48h'

  if badge_product.available
    if badge_product.tags contains 'livraison-24-48h'
      assign show_badge = true
    elsif badge_product.tags contains 'livraison-24-48'
      assign show_badge = true
    elsif badge_product.tags contains '24-48h'
      assign show_badge = true
    endif
  endif

  assign badge_class = 'delivery-badge'
  if class != blank
    assign badge_class = badge_class | append: ' ' | append: class
  endif
-%}

{%- if show_badge -%}
  <span class="{{ badge_class }}">
    <span class="delivery-badge__dot" aria-hidden="true"></span>
    {{ badge_label }}
  </span>
{%- endif -%}
