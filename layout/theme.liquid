{%- liquid
  assign seo_brand_name = 'LAbasket75'
  assign seo_page_title = page_title
  assign seo_page_description = page_description

  if request.page_type == 'index'
    assign seo_page_title = 'LAbasket75 | Sneakers authentiques et modèles recherchés'
    assign seo_page_description = 'Découvrez LAbasket75 : sneakers authentiques, modèles recherchés et tailles disponibles, avec paiement sécurisé et expédition soignée.'
  endif
-%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="theme-color" content="#000000">
  <link rel="canonical" href="{{ canonical_url }}">
  <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">

  <title>
    {{ seo_page_title }}
    {%- if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless seo_page_title contains seo_brand_name %} &ndash; {{ seo_brand_name }}{% endunless -%}
  </title>

  {%- if seo_page_description -%}
    <meta name="description" content="{{ seo_page_description | escape }}">
  {%- endif -%}

  {%- render 'meta-tags', seo_page_title: seo_page_title, seo_page_description: seo_page_description, seo_brand_name: seo_brand_name -%}

  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'component-product-card.css' | asset_url | stylesheet_tag }}

  {{ content_for_header }}
</head>

<body class="template-{{ template.name | handle }}">
  {%- sections 'header-group' -%}

  <main id="main-content" role="main" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {%- sections 'footer-group' -%}
  {%- render 'cart-drawer' -%}

  <script src="{{ 'global.js' | asset_url }}" defer></script>
</body>
</html>
