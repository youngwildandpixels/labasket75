{%- comment -%} Page Boutique — adresse, horaires, services et photos Kozy Sneakers {%- endcomment -%}
<section class="boutique-page" id="boutique-page-{{ section.id }}">
  <div class="boutique-page__inner container">
    <div class="boutique-page__hero">
      <div class="boutique-page__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="boutique-page__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h1 class="boutique-page__title">{{ section.settings.title | default: page.title | escape }}</h1>
        {%- if section.settings.intro != blank -%}
          <div class="boutique-page__intro">{{ section.settings.intro }}</div>
        {%- endif -%}
        {%- if section.settings.about_text != blank -%}
          <div class="boutique-page__about">{{ section.settings.about_text }}</div>
        {%- endif -%}
      </div>

      {%- if section.settings.hero_image != blank -%}
        <div class="boutique-page__hero-media">
          {{
            section.settings.hero_image
            | image_url: width: 1200
            | image_tag:
              loading: 'eager',
              widths: '480, 720, 960, 1200',
              sizes: '(max-width: 900px) 100vw, 44vw',
              class: 'boutique-page__image',
              alt: section.settings.hero_image.alt
          }}
        </div>
      {%- endif -%}
    </div>

    <div class="boutique-page__summary" aria-label="Horaires boutique">
      <div>
        <span class="boutique-page__label">Horaires</span>
        <p>Lundi {{ section.settings.monday_hours }}<br>Mardi au Samedi {{ section.settings.week_hours }}</p>
      </div>
    </div>

    {%- if section.settings.gallery_image_1 != blank or section.settings.gallery_image_2 != blank or section.settings.gallery_image_3 != blank -%}
      <div class="boutique-page__gallery" aria-label="Photos de la boutique">
        {%- for index in (1..3) -%}
          {%- liquid
            assign image_setting = 'gallery_image_' | append: index
            assign caption_setting = 'gallery_caption_' | append: index
            assign gallery_image = section.settings[image_setting]
            assign gallery_caption = section.settings[caption_setting]
          -%}
          {%- if gallery_image != blank -%}
            <figure class="boutique-page__gallery-item">
              <div class="boutique-page__gallery-media">
                {{
                  gallery_image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '360, 520, 720, 900',
                    sizes: '(max-width: 760px) 100vw, 33vw',
                    class: 'boutique-page__image',
                    alt: gallery_image.alt
                }}
              </div>
              {%- if gallery_caption != blank -%}
                <figcaption>{{ gallery_caption }}</figcaption>
              {%- endif -%}
            </figure>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="boutique-page__visit">
      <div>
        <p class="boutique-page__eyebrow">Clermont-Ferrand</p>
        <h2>{{ section.settings.address_title }}</h2>
      </div>
      <div class="boutique-page__visit-copy">
        <p>{{ section.settings.address }}</p>
        {%- if section.settings.map_link != blank -%}
          <a href="{{ section.settings.map_link }}" class="btn btn--primary" target="_blank" rel="noopener">
            Ouvrir l'itinéraire
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.boutique-page {
  padding: var(--space-12) 0 var(--space-16);
}

.boutique-page__inner {
  display: grid;
  gap: var(--space-10);
  max-width: 1120px;
}

.boutique-page__hero {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(320px, 0.82fr);
  gap: var(--space-8);
  align-items: center;
}

.boutique-page__copy {
  max-width: 560px;
}

.boutique-page__eyebrow {
  margin: 0 0 var(--space-3);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-semibold);
  letter-spacing: 0;
  text-transform: uppercase;
  color: var(--color-gray-500);
}

.boutique-page__title {
  margin: 0;
  font-size: 40px;
  font-weight: var(--font-weight-bold);
  line-height: 1.05;
  letter-spacing: 0;
}

.boutique-page__intro {
  max-width: 480px;
  margin-top: var(--space-4);
  font-size: 16px;
  line-height: 1.5;
  color: var(--color-gray-700);
}

.boutique-page__about {
  max-width: 560px;
  margin-top: var(--space-5);
  font-size: 15px;
  line-height: 1.55;
  color: var(--color-gray-700);
}

.boutique-page__about p {
  margin: 0;
}

.boutique-page__hero-media {
  aspect-ratio: 4 / 3;
  overflow: hidden;
  background: var(--color-gray-100);
}

.boutique-page__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.boutique-page__summary {
  padding: var(--space-6) 0;
  border-top: 1px solid var(--color-gray-200);
  border-bottom: 1px solid var(--color-gray-200);
}

.boutique-page__label {
  display: block;
  margin-bottom: var(--space-2);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-semibold);
  text-transform: uppercase;
  color: var(--color-gray-500);
}

.boutique-page__summary p {
  margin: 0;
  font-size: 18px;
  font-weight: var(--font-weight-medium);
  line-height: 1.35;
}

.boutique-page__gallery {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-4);
}

.boutique-page__gallery-item {
  display: grid;
  gap: var(--space-2);
}

.boutique-page__gallery-media {
  aspect-ratio: 1 / 1;
  overflow: hidden;
  background: var(--color-gray-100);
}

.boutique-page__gallery-item figcaption {
  font-size: var(--font-size-small);
  color: var(--color-gray-700);
}

.boutique-page__visit {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(280px, 0.72fr);
  gap: var(--space-8);
  padding-top: var(--space-6);
  border-top: 1px solid var(--color-black);
  align-items: start;
}

.boutique-page__visit h2 {
  margin: 0;
  font-size: 28px;
  font-weight: var(--font-weight-bold);
  line-height: 1.1;
  letter-spacing: 0;
}

.boutique-page__visit-copy p {
  margin: 0 0 var(--space-5);
  font-size: 16px;
  line-height: 1.45;
}

@media (max-width: 900px) {
  .boutique-page {
    padding: var(--space-10) 0 var(--space-12);
  }

  .boutique-page__hero,
  .boutique-page__visit {
    grid-template-columns: 1fr;
  }

  .boutique-page__title {
    font-size: 32px;
  }

  .boutique-page__summary p {
    font-size: 16px;
  }

  .boutique-page__gallery {
    grid-template-columns: 1fr;
  }

  .boutique-page__gallery-media {
    aspect-ratio: 4 / 3;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Page boutique",
  "tag": "section",
  "settings": [
