{%- comment -%}
  Related Products — "Vous aimerez aussi"
  Recommandations basées sur la première collection du produit
{%- endcomment -%}
{%- liquid
  assign first_col = product.collections.first
  assign limit = section.settings.products_to_show
-%}

<section class="related">
  <div class="related__head container">
    <h2 class="related__title">{{ section.settings.heading | default: 'Vous aimerez aussi' }}</h2>
    {%- if first_col != blank -%}
      <a href="{{ first_col.url }}" class="related__cta">Voir tout</a>
    {%- endif -%}
  </div>

  {%- if first_col != blank and first_col.products.size > 1 -%}
    <div class="related__slider">
      <button class="related__arrow related__arrow--prev" type="button" data-related-prev aria-label="Produits précédents">
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
          <path d="M11.5 3.5L6 9l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

      <div class="related__track" data-track>
        {%- for p in first_col.products limit: limit -%}
          {%- if p.id != product.id -%}
            <div class="related__item">
              {%- render 'product-card', product: p, show_vendor: true, show_secondary_image: true, lazy: 'lazy' -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <button class="related__arrow related__arrow--next" type="button" data-related-next aria-label="Produits suivants">
        <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true">
          <path d="M6.5 3.5L12 9l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
.related {
  margin: var(--surface-gap);
  padding: clamp(var(--space-8), 5vw, var(--space-16)) 0 var(--space-12);
  background: var(--surface-card);
  border: var(--surface-border);
  border-radius: var(--surface-radius);
  box-shadow: var(--surface-shadow);
  overflow: hidden;
}

.related__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-8);
  gap: var(--space-4);
}

.related__title {
  font-size: clamp(32px, 4vw, 46px);
  font-weight: var(--font-weight-bold);
  letter-spacing: -1px;
  margin: 0;
}

.related__cta {
  position: relative;
  display: inline-flex;
  align-items: center;
  border: 0;
  border-radius: 0;
  padding: 8px 0;
  font-size: var(--font-size-small);
  font-weight: var(--font-weight-medium);
  transition: opacity 0.15s;
}
.related__cta::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 2px;
  height: 2px;
  background: currentColor;
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.24s ease;
}
.related__cta:hover,
.related__cta:focus-visible { opacity: 1; }
.related__cta:hover::after,
.related__cta:focus-visible::after { transform: scaleX(1); }

.related__slider {
  position: relative;
}

.related__track {
  display: flex;
  gap: 1px;
  background: var(--color-white);
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  padding: 0 var(--space-10);
}
.related__track::-webkit-scrollbar { display: none; }

.related__arrow {
  position: absolute;
  top: 50%;
  z-index: 2;
  width: 38px;
  height: 38px;
  border: 1.5px solid var(--color-black);
  border-radius: 50%;
  background: var(--color-white);
  color: var(--color-black);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  transform: translateY(-50%);
  transition: background 0.15s ease, color 0.15s ease, opacity 0.15s ease;
}

.related__arrow:hover {
  background: var(--color-black);
  color: var(--color-white);
  opacity: 1;
}

.related__arrow:disabled {
  opacity: 0.25;
  cursor: default;
}

.related__arrow--prev {
  left: var(--space-4);
}

.related__arrow--next {
  right: var(--space-4);
}

.related .product-card__media {
  aspect-ratio: 4 / 5;
}

.related__item {
  flex: 0 0 calc(25% - 1px);
  min-width: 0;
  background: var(--color-white);
  scroll-snap-align: start;
}

@media (max-width: 1024px) {
  .related__item { flex: 0 0 calc(33.333% - 1px); }
}

@media (max-width: 768px) {
  .related { padding: var(--space-7) 0; }
  .related__head {
    align-items: flex-end;
    margin-bottom: var(--space-5);
  }
  .related__title {
    font-size: 30px;
  }
  .related__track { padding: 0 var(--space-5); }
  .related__item { flex: 0 0 calc(68% - 1px); }
  .related__arrow { display: none; }
}
{% endstylesheet %}

<script>
(function () {
  var sections = document.querySelectorAll('.related');
  if (!sections.length) return;

  sections.forEach(function (section) {
    var track = section.querySelector('[data-track]');
    var prev = section.querySelector('[data-related-prev]');
    var next = section.querySelector('[data-related-next]');
    if (!track || !prev || !next || track.dataset.arrowsInit === 'true') return;
    track.dataset.arrowsInit = 'true';

    function getStep() {
      var item = track.querySelector('.related__item');
      if (!item) return Math.round(track.clientWidth * 0.8);
      var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return Math.round(item.offsetWidth + gap);
    }

    function updateArrows() {
      var maxScroll = track.scrollWidth - track.clientWidth;
      var isScrollable = maxScroll > 1;
      prev.hidden = !isScrollable;
      next.hidden = !isScrollable;
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft >= maxScroll - 1;
    }

    prev.addEventListener('click', function () {
      track.scrollBy({ left: -getStep(), behavior: 'smooth' });
    });

    next.addEventListener('click', function () {
      track.scrollBy({ left: getStep(), behavior: 'smooth' });
    });

    track.addEventListener('scroll', updateArrows);
    window.addEventListener('resize', updateArrows);
    updateArrows();
  });
})();
</script>

{% schema %}
{
  "name": "Related Products",
  "tag": "section",
  "settings": [
    { "type": "text",  "id": "heading",          "label": "Titre",            "default": "Vous aimerez aussi" },
    { "type": "range", "id": "products_to_show", "label": "Nombre de produits", "min": 4, "max": 16, "step": 2, "default": 8 }
  ],
  "presets": [{ "name": "Related Products" }]
}
{% endschema %}
