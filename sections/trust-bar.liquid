{%- comment -%} Trust Bar — 4 icônes de confiance {%- endcomment -%}

<section class="trust-bar">
  <div class="trust-bar__inner container">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="trust-bar__item" {{ block.shopify_attributes }}>
          <div class="trust-bar__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'store' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              {%- when 'badge' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
              {%- when 'truck' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              {%- when 'headphones' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0118 0v6"/><path d="M21 19a2 2 0 01-2 2h-1a2 2 0 01-2-2v-3a2 2 0 012-2h3zM3 19a2 2 0 002 2h1a2 2 0 002-2v-3a2 2 0 00-2-2H3z"/></svg>
            {%- endcase -%}
          </div>
          <div class="trust-bar__copy">
            <p class="trust-bar__title">{{ block.settings.title }}</p>
            {%- if block.settings.subtitle != blank -%}
              <p class="trust-bar__subtitle">{{ block.settings.subtitle }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="trust-bar__item">
        <div class="trust-bar__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
        </div>
        <div class="trust-bar__copy">
          <p class="trust-bar__title">Authenticité garantie</p>
          <p class="trust-bar__subtitle">Chaque paire est contrôlée avant expédition</p>
        </div>
      </div>
      <div class="trust-bar__item">
        <div class="trust-bar__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        </div>
        <div class="trust-bar__copy">
          <p class="trust-bar__title">Livraison rapide</p>
          <p class="trust-bar__subtitle">24/48h selon disponibilité boutique</p>
        </div>
      </div>
      <div class="trust-bar__item">
        <div class="trust-bar__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        </div>
        <div class="trust-bar__copy">
          <p class="trust-bar__title">Retrait boutique</p>
          <p class="trust-bar__subtitle">Disponible sur les produits en stock</p>
        </div>
      </div>
      <div class="trust-bar__item">
        <div class="trust-bar__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0118 0v6"/><path d="M21 19a2 2 0 01-2 2h-1a2 2 0 01-2-2v-3a2 2 0 012-2h3zM3 19a2 2 0 002 2h1a2 2 0 002-2v-3a2 2 0 00-2-2H3z"/></svg>
        </div>
        <div class="trust-bar__copy">
          <p class="trust-bar__title">SAV réactif</p>
          <p class="trust-bar__subtitle">Une équipe disponible avant et après achat</p>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.trust-bar {
  margin: var(--surface-gap);
  padding: var(--space-3);
  background: var(--surface-card);
  border: var(--surface-border);
  border-radius: var(--surface-radius);
  box-shadow: var(--surface-shadow);
  overflow: hidden;
}

.trust-bar__inner {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: var(--surface-gap);
  max-width: none;
  padding: 0;
}

.trust-bar__item {
  position: relative;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  align-items: center;
  column-gap: var(--space-3);
  min-height: 78px;
  padding: var(--space-4);
  background: var(--color-gray-100);
  border: 1px solid transparent;
  border-radius: var(--control-radius);
  transition: background 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
}

.trust-bar__item::before {
  content: "";
  position: absolute;
  left: var(--space-4);
  right: var(--space-4);
  top: 0;
  height: 2px;
  background: var(--color-black);
  border-radius: 9999px;
  transform: scaleX(0.34);
  transform-origin: left;
  opacity: 0.22;
  transition: transform 0.22s ease, opacity 0.22s ease;
}

.trust-bar__item:hover {
  background: var(--color-white);
  border-color: var(--color-gray-200);
  transform: translateY(-1px);
}

.trust-bar__item:hover::before {
  transform: scaleX(1);
  opacity: 1;
}

.trust-bar__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  color: var(--color-black);
  background: var(--color-white);
  border: var(--surface-border);
  border-radius: 9999px;
}

.trust-bar__icon svg {
  width: 18px;
  height: 18px;
}

.trust-bar__title {
  margin: 0 0 3px;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
  color: var(--color-black);
  line-height: 1.15;
}

.trust-bar__subtitle {
  margin: 0;
  font-size: var(--font-size-xs);
  color: var(--color-gray-500);
  line-height: 1.35;
}

@media (max-width: 768px) {
  .trust-bar {
    padding: var(--surface-gap);
  }

  .trust-bar__inner {
    grid-template-columns: 1fr;
  }

  .trust-bar__item {
    min-height: 66px;
    padding: var(--space-3);
  }

  .trust-bar__icon {
    width: 34px;
    height: 34px;
  }

  .trust-bar__title {
    font-size: var(--font-size-small);
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Trust Bar",
  "tag": "section",
  "blocks": [
    {
      "type": "item",
      "name": "Élément",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icône",
          "options": [
            { "value": "store",      "label": "Boutique" },
            { "value": "badge",      "label": "Badge" },
            { "value": "truck",      "label": "Livraison" },
            { "value": "headphones", "label": "SAV" }
          ],
          "default": "store"
        },
        { "type": "text", "id": "title",    "label": "Titre",      "default": "Click & Collect" },
        { "type": "text", "id": "subtitle", "label": "Sous-titre", "default": "Disponible en boutique" }
      ]
    }
  ],
  "presets": [{
    "name": "Trust Bar",
    "blocks": [
      { "type": "item", "settings": { "icon": "store",      "title": "Click & Collect",   "subtitle": "Disponible en boutique" } },
      { "type": "item", "settings": { "icon": "badge",      "title": "100% Authentiques", "subtitle": "Produits garantis originaux" } },
      { "type": "item", "settings": { "icon": "truck",      "title": "Livraison rapide",   "subtitle": "24/48h en France" } },
      { "type": "item", "settings": { "icon": "headphones", "title": "SAV réactif",        "subtitle": "Une question ? On répond" } }
    ]
  }]
}
{% endschema %}
