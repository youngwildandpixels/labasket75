{%- comment -%} Trust Bar — 4 icônes de confiance {%- endcomment -%}

<section
  class="trust-bar trust-bar--text-{{ section.settings.text_position | default: 'top-left' }}"
  {% if section.settings.background_image != blank %}
    style="--trust-bar-bg: url('{{ section.settings.background_image | image_url: width: 2200 }}');"
  {% endif %}
>
  <div class="trust-bar__inner">
    <div class="trust-bar__content">
      <p class="trust-bar__eyebrow">{{ section.settings.eyebrow | default: 'La Basket 75' }}</p>
      <h2 class="trust-bar__heading">{{ section.settings.heading | default: 'Acheter avec confiance' }}</h2>
    </div>

    <div class="trust-bar__pills">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        <div class="trust-bar__item" {{ block.shopify_attributes }}>
          <div class="trust-bar__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'store' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              {%- when 'badge' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
              {%- when 'truck' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              {%- when 'headphones' -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0118 0v6"/><path d="M21 19a2 2 0 01-2 2h-1a2 2 0 01-2-2v-3a2 2 0 012-2h3zM3 19a2 2 0 002 2h1a2 2 0 002-2v-3a2 2 0 00-2-2H3z"/></svg>
            {%- endcase -%}
          </div>
          <div class="trust-bar__copy">
            <p class="trust-bar__title">{{ block.settings.title }}</p>
            {%- if block.settings.subtitle != blank -%}
              <p class="trust-bar__subtitle">{{ block.settings.subtitle }}</p>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="trust-bar__item">
        <div class="trust-bar__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
        </div>
        <div class="trust-bar__copy">
          <p class="trust-bar__title">Authenticité garantie</p>
          <p class="trust-bar__subtitle">Chaque paire est contrôlée avant expédition</p>
        </div>
      </div>
      <div class="trust-bar__item">
        <div class="trust-bar__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        </div>
        <div class="trust-bar__copy">
          <p class="trust-bar__title">Livraison rapide</p>
          <p class="trust-bar__subtitle">24/48h selon disponibilité boutique</p>
        </div>
      </div>
      <div class="trust-bar__item">
        <div class="trust-bar__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        </div>
        <div class="trust-bar__copy">
          <p class="trust-bar__title">Retrait boutique</p>
          <p class="trust-bar__subtitle">Disponible sur les produits en stock</p>
        </div>
      </div>
      <div class="trust-bar__item">
        <div class="trust-bar__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0118 0v6"/><path d="M21 19a2 2 0 01-2 2h-1a2 2 0 01-2-2v-3a2 2 0 012-2h3zM3 19a2 2 0 002 2h1a2 2 0 002-2v-3a2 2 0 00-2-2H3z"/></svg>
        </div>
        <div class="trust-bar__copy">
          <p class="trust-bar__title">SAV réactif</p>
          <p class="trust-bar__subtitle">Une équipe disponible avant et après achat</p>
        </div>
      </div>
    {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.trust-bar {
  position: relative;
  margin: var(--surface-gap);
  min-height: clamp(270px, 31.5vw, 420px);
  padding: var(--space-10);
  background-color: #1f1f1f;
  background-image: var(--trust-bar-bg);
  background-size: cover;
  background-position: center;
  border: var(--surface-border);
  border-radius: var(--surface-radius);
  box-shadow: var(--surface-shadow);
  overflow: hidden;
}

.trust-bar::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;
  background: linear-gradient(270deg, rgba(0, 0, 0, 0.72) 0%, rgba(0, 0, 0, 0.48) 38%, rgba(0, 0, 0, 0.22) 66%, rgba(0, 0, 0, 0.12) 100%);
  pointer-events: none;
}

.trust-bar__inner {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(320px, 430px);
  align-content: stretch;
  align-items: stretch;
  justify-content: space-between;
  gap: var(--space-6);
  width: 100%;
  min-height: inherit;
  padding: 0;
}

.trust-bar__content {
  display: grid;
  gap: var(--space-3);
  width: min(620px, 100%);
  text-align: left;
  color: var(--color-white);
}

.trust-bar--text-top-left .trust-bar__content,
.trust-bar--text-center-left .trust-bar__content,
.trust-bar--text-bottom-left .trust-bar__content {
  justify-self: start;
  text-align: left;
}

.trust-bar--text-top-right .trust-bar__content,
.trust-bar--text-center-right .trust-bar__content,
.trust-bar--text-bottom-right .trust-bar__content {
  justify-self: end;
  text-align: right;
}

.trust-bar--text-top-left .trust-bar__content,
.trust-bar--text-top-right .trust-bar__content {
  align-self: start;
}

.trust-bar--text-center-left .trust-bar__content,
.trust-bar--text-center-right .trust-bar__content {
  align-self: center;
}

.trust-bar--text-bottom-left .trust-bar__content,
.trust-bar--text-bottom-right .trust-bar__content {
  align-self: end;
}

.trust-bar__eyebrow {
  margin: 0;
  color: rgba(255, 255, 255, 0.72);
  font-size: var(--font-size-small);
  font-weight: var(--font-weight-semibold);
  letter-spacing: 2px;
  text-transform: uppercase;
  white-space: pre-line;
}

.trust-bar__heading {
  margin: 0;
  color: var(--color-white);
  font-size: clamp(30px, 4.2vw, 56px);
  font-weight: var(--font-weight-bold);
  line-height: 1;
  letter-spacing: 0;
  text-transform: none;
  white-space: pre-line;
}

.trust-bar__pills {
  display: flex;
  flex-direction: column;
  flex-wrap: nowrap;
  justify-content: flex-end;
  align-self: center;
  justify-self: end;
  gap: var(--surface-gap);
  width: min(430px, 100%);
}

.trust-bar__item {
  position: relative;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  align-items: center;
  column-gap: var(--space-3);
  min-height: 58px;
  width: 100%;
  flex: 0 0 auto;
  padding: var(--space-3) var(--space-4);
  background: rgba(255, 255, 255, 0.26);
  border: 1px solid rgba(255, 255, 255, 0.38);
  border-radius: 9999px;
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.42), 0 12px 28px rgba(0, 0, 0, 0.12);
  backdrop-filter: blur(26px) saturate(1.28);
  -webkit-backdrop-filter: blur(26px) saturate(1.28);
  transition: background 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
}

.trust-bar__item:hover {
  background: rgba(255, 255, 255, 0.34);
  border-color: rgba(255, 255, 255, 0.58);
  box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.55), 0 14px 30px rgba(0, 0, 0, 0.14);
  transform: translateY(-1px);
}

.trust-bar__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  color: var(--color-black);
  background: rgba(255, 255, 255, 0.28);
  border: 1px solid rgba(255, 255, 255, 0.3);
  border-radius: 9999px;
}

.trust-bar__icon svg {
  width: 16px;
  height: 16px;
}

.trust-bar__title {
  margin: 0 0 3px;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
  color: rgba(0, 0, 0, 0.9);
  line-height: 1.15;
  white-space: pre-line;
}

.trust-bar__subtitle {
  margin: 0;
  font-size: var(--font-size-small);
  font-weight: var(--font-weight-medium);
  color: rgba(0, 0, 0, 0.68);
  line-height: 1.35;
  white-space: pre-line;
}

@media (max-width: 768px) {
  .trust-bar {
    min-height: 390px;
    padding: var(--space-5);
    background-position: center;
  }

  .trust-bar::before {
    background: linear-gradient(0deg, rgba(0, 0, 0, 0.86) 0%, rgba(0, 0, 0, 0.62) 48%, rgba(0, 0, 0, 0.08) 100%);
  }

  .trust-bar__inner {
    grid-template-columns: 1fr;
    align-content: space-between;
    justify-items: stretch;
    gap: var(--space-5);
  }

  .trust-bar__content {
    justify-self: start;
    text-align: left;
  }

  .trust-bar__heading {
    font-size: clamp(28px, 8vw, 40px);
  }

  .trust-bar__pills {
    justify-content: flex-start;
    align-self: end;
    justify-self: stretch;
  }

  .trust-bar__item {
    flex-basis: 100%;
    min-height: 58px;
    padding: var(--space-3);
  }

  .trust-bar__icon {
    width: 34px;
    height: 34px;
  }

  .trust-bar__title {
    font-size: var(--font-size-small);
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Trust Bar",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "Image de fond" },
    { "type": "text", "id": "eyebrow", "label": "Petit texte", "default": "La Basket 75" },
    { "type": "textarea", "id": "heading", "label": "Texte display", "default": "Acheter avec confiance" },
    {
      "type": "select",
      "id": "text_position",
      "label": "Disposition du texte",
      "options": [
        { "value": "top-left", "label": "Haut gauche" },
        { "value": "center-left", "label": "Centre gauche" },
        { "value": "bottom-left", "label": "Bas gauche" },
        { "value": "top-right", "label": "Haut droite" },
        { "value": "center-right", "label": "Centre droite" },
        { "value": "bottom-right", "label": "Bas droite" }
      ],
      "default": "top-left"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Élément",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icône",
          "options": [
            { "value": "store",      "label": "Boutique" },
            { "value": "badge",      "label": "Badge" },
            { "value": "truck",      "label": "Livraison" },
            { "value": "headphones", "label": "SAV" }
          ],
          "default": "store"
        },
        { "type": "text", "id": "title",    "label": "Titre",      "default": "Click & Collect" },
        { "type": "text", "id": "subtitle", "label": "Sous-titre", "default": "Disponible en boutique" }
      ]
    }
  ],
  "presets": [{
    "name": "Trust Bar",
    "blocks": [
      { "type": "item", "settings": { "icon": "store",      "title": "Click & Collect",   "subtitle": "Disponible en boutique" } },
      { "type": "item", "settings": { "icon": "badge",      "title": "100% Authentiques", "subtitle": "Produits garantis originaux" } },
      { "type": "item", "settings": { "icon": "truck",      "title": "Livraison rapide",   "subtitle": "24/48h en France" } },
      { "type": "item", "settings": { "icon": "headphones", "title": "SAV réactif",        "subtitle": "Une question ? On répond" } }
    ]
  }]
}
{% endschema %}
