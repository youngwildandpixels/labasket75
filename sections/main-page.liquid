{%- comment -%} Main Page — page statique : H1 + contenu rich text {%- endcomment -%}
<section class="page">
  <div class="page__inner container">
    <header class="page__header">
      <h1 class="page__title">{{ page.title | escape }}</h1>
    </header>

    {%- if page.content != blank -%}
      <div class="page__content rte">
        {{ page.content | replace: '&amp;nbsp;', ' ' | replace: '&nbsp;', ' ' }}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.page {
  padding: var(--space-12) 0;
}

.page__inner {
  max-width: 760px;
}

.page__header {
  margin-bottom: var(--space-8);
  text-align: center;
}

.page__title {
  font-size: var(--font-size-display);
  font-weight: var(--font-weight-bold);
  line-height: 1.0;
  letter-spacing: -1px;
  text-transform: uppercase;
  margin: 0;
}

.page__content {
  font-size: var(--font-size-body);
  color: var(--color-black);
  line-height: 1.6;
}

.page__content p { margin-bottom: var(--space-4); }
.page__content h2 { margin: var(--space-8) 0 var(--space-3); }
.page__content h3 { margin: var(--space-6) 0 var(--space-3); }
.page__content ul,
.page__content ol { margin: 0 0 var(--space-4) var(--space-6); }
.page__content li { margin-bottom: var(--space-1); }
.page__content a { text-decoration: underline; }

/* Pages de politique boutique (CGU, CGV, remboursement...) : Shopify impose son
   propre gabarit (shopify-policy__*), non personnalisable via un template ou une
   section. On aligne son rendu sur le style de .page ci-dessus par surcharge CSS. */
.shopify-policy__container {
  max-width: 760px;
  margin: 0 auto;
  padding: var(--space-12) var(--space-5);
}

.shopify-policy__title h1 {
  font-size: var(--font-size-display);
  font-weight: var(--font-weight-bold);
  line-height: 1.0;
  letter-spacing: -1px;
  text-transform: uppercase;
  text-align: center;
  margin: 0 0 var(--space-8);
}

.shopify-policy__body {
  font-size: var(--font-size-body);
  color: var(--color-black);
  line-height: 1.6;
}

.shopify-policy__body .policy-page > h1:first-child {
  display: none;
}

.shopify-policy__body h2 {
  font-size: 22px;
  font-weight: var(--font-weight-bold);
  text-transform: uppercase;
  margin: var(--space-8) 0 var(--space-3);
}

.shopify-policy__body p { margin: 0 0 var(--space-4); }
.shopify-policy__body ul,
.shopify-policy__body ol { margin: 0 0 var(--space-4) var(--space-6); }
.shopify-policy__body li { margin-bottom: var(--space-1); }
.shopify-policy__body a { text-decoration: underline; }

@media (max-width: 768px) {
  .page__title { font-size: 32px; letter-spacing: -0.5px; }

  .shopify-policy__container { padding: var(--space-8) var(--space-4); }
  .shopify-policy__title h1 { font-size: 32px; letter-spacing: -0.5px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Page",
  "tag": "section",
  "settings": []
}
{% endschema %}
