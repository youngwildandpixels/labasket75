      "default": "<p>Redonne vie à tes sneakers, sacs et accessoires avec un entretien adapté aux matières. Dépose en boutique, diagnostic rapide et résultat propre.</p>"
    },
    {
      "type": "text",
      "id": "primary_cta_label",
      "label": "Texte bouton principal",
      "default": "Nous contacter"
    },
    {
      "type": "url",
      "id": "primary_cta_link",
      "label": "Lien bouton principal"
    },
    {
      "type": "text",
      "id": "secondary_cta_label",
      "label": "Texte bouton secondaire",
      "default": "Voir les tarifs"
    },
    {
      "type": "url",
      "id": "secondary_cta_link",
      "label": "Lien bouton secondaire"
    }
  ],
  "presets": [
    {
      "name": "Page nettoyage"
    }
  ]
}
{% endschema %}
