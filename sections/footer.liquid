{%- comment -%} Footer — colonnes éditables + barre basse {%- endcomment -%}
<footer class="site-footer" role="contentinfo">
  <div class="site-footer__inner container">
    <div class="site-footer__top">
      <div class="footer-contact">
        <p class="footer-title">{{ section.settings.contact_heading | default: 'Nous contacter' }}</p>
        <a href="{{ section.settings.contact_link | default: routes.root_url }}" class="footer-contact__card">
          <span class="footer-contact__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>
            </svg>
          </span>
          <span class="footer-contact__label">{{ section.settings.contact_label | default: 'Portail de contact' }}</span>
        </a>
        <p class="footer-text footer-contact__text">
          {{ section.settings.contact_text | default: "Notre équipe s'engage à vous répondre en 24 à 48h ouvrées." }}
        </p>
      </div>

      <div class="footer-about">
        <p class="footer-title">{{ section.settings.about_heading | default: 'À propos de Kozy Sneakers' }}</p>
        <p class="footer-text">
          {{ section.settings.about_text | default: "Kozy Sneakers sélectionne des sneakers, vêtements et accessoires pour les passionnés de style, de confort et de belles pièces." }}
        </p>
      </div>

      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks limit: 4 -%}
          {%- if block.type == 'menu' -%}
            <div class="footer-col" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <p class="footer-title">{{ block.settings.heading }}</p>
              {%- endif -%}
              {%- if block.settings.menu != blank and block.settings.menu.links.size > 0 -%}
                <ul class="footer-list">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}" class="footer-link">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <div class="footer-col">
          <p class="footer-title">En savoir plus</p>
          <ul class="footer-list">
            <li><a href="/pages/notre-concept" class="footer-link">Boutique</a></li>
            <li><a href="/pages/faq" class="footer-link">FAQ</a></li>
            <li><a href="/pages/contact" class="footer-link">Contact</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <p class="footer-title">Nos collections</p>
          <ul class="footer-list">
            <li><a href="{{ routes.all_products_collection_url }}" class="footer-link">Nos marques</a></li>
            <li><a href="{{ routes.collections_url }}/sneakers" class="footer-link">Sneakers</a></li>
            <li><a href="{{ routes.collections_url }}/accessoires" class="footer-link">Accessoires</a></li>
          </ul>
        </div>
      {%- endif -%}

      <div class="footer-social">
        <p class="footer-title">{{ section.settings.social_heading | default: 'Retrouvez-nous sur' }}</p>
        <div class="footer-social__list">
          {%- if section.settings.instagram_url != blank -%}
            <a href="{{ section.settings.instagram_url }}" class="footer-social__link" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.tiktok_url != blank -%}
            <a href="{{ section.settings.tiktok_url }}" class="footer-social__link" aria-label="TikTok">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15.7 3c.4 3 2 4.8 5.1 5v3.4c-1.8.1-3.4-.4-5-1.5v6.3c0 7.9-8.7 10.4-12.2 4.7-2.3-3.7-.9-10.1 6.4-10.4v3.6c-.6.1-1.2.2-1.8.5-1.7.8-2.6 2.3-2.3 4 .6 3.2 6.3 4.2 6.8-1.1V3h3Z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.facebook_url != blank -%}
            <a href="{{ section.settings.facebook_url }}" class="footer-social__link" aria-label="Facebook">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 8h3V4h-3c-3.3 0-5 2-5 5v3H6v4h3v8h4v-8h3.4l.6-4h-4V9c0-.7.3-1 1-1Z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.pinterest_url != blank -%}
            <a href="{{ section.settings.pinterest_url }}" class="footer-social__link" aria-label="Pinterest">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.2 2C6.9 2 4 5.5 4 9.4c0 2.4 1.3 4.1 3.1 4.1.6 0 .9-1.6.9-2 0-.5-1.2-1.5-1.2-3.4 0-2.7 2-4.8 4.8-4.8 2.4 0 4.2 1.4 4.2 3.9 0 1.9-.8 5.4-3.3 5.4-1 0-1.8-.7-1.5-1.8.4-1.4 1.1-2.9 1.1-4 0-.9-.5-1.7-1.5-1.7-1.2 0-2.1 1.2-2.1 2.8 0 1 .3 1.7.3 1.7L7.5 16c-.5 2-.1 4.5 0 4.8.1.1.2.1.3 0 .2-.3 2.4-3 3-5.1.2-.6.9-3.4.9-3.4.5.8 1.6 1.5 2.8 1.5 3.7 0 6.2-3.4 6.2-7.8C20.7 2.9 17.8 2 12.2 2Z"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>

    <div class="site-footer__bottom">
      <div class="footer-legal">
        {%- if section.settings.legal_menu != blank and section.settings.legal_menu.links.size > 0 -%}
          {%- for link in section.settings.legal_menu.links -%}
            <a href="{{ link.url }}" class="footer-legal__link">{{ link.title }}</a>
          {%- endfor -%}
        {%- else -%}
          <a href="/policies/legal-notice" class="footer-legal__link">Mentions légales</a>
          <a href="/policies/privacy-policy" class="footer-legal__link">Politique de confidentialité</a>
          <a href="/policies/terms-of-service" class="footer-legal__link">CGU</a>
          <a href="/policies/refund-policy" class="footer-legal__link">CGV</a>
        {%- endif -%}
      </div>

      <div class="footer-badges">
        <p class="footer-title">Moyens de paiement</p>
        <div class="footer-badges__row" aria-label="Moyens de paiement">
          <span class="footer-badge footer-badge--visa">VISA</span>
          <span class="footer-badge footer-badge--mc">MC</span>
          <span class="footer-badge footer-badge--amex">AMEX</span>
        </div>
      </div>

      <div class="footer-badges">
        <p class="footer-title">Transporteurs</p>
        <div class="footer-badges__row" aria-label="Transporteurs">
          <span class="footer-badge footer-badge--dhl">DHL</span>
          <span class="footer-badge footer-badge--ship">Chrono</span>
        </div>
      </div>

      <div class="footer-locale">
        <span>Français</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m6 9 6 6 6-6"/>
        </svg>
      </div>
    </div>
  </div>
</footer>

{% stylesheet %}
.site-footer {
  --footer-block-gap: var(--surface-gap);
  --footer-block-radius: var(--surface-radius);
  --footer-block-border: var(--surface-border);
  --footer-block-shadow: var(--surface-shadow);
  margin: var(--footer-block-gap);
  background: #303030;
  border: var(--footer-block-border);
  border-radius: var(--footer-block-radius);
  box-shadow: var(--footer-block-shadow);
  color: var(--color-white);
  overflow: hidden;
  padding: 76px 0 64px;
}

.site-footer__top {
  display: grid;
  grid-template-columns: minmax(160px, 1fr) minmax(180px, 1.15fr) repeat(4, minmax(130px, 1fr));
  gap: clamp(28px, 4vw, 72px);
  align-items: start;
}

.footer-title {
  color: var(--color-white);
  font-size: 15px;
  font-weight: var(--font-weight-bold);
  line-height: 1.2;
  margin: 0 0 22px;
}

.footer-text,
.footer-link,
.footer-legal__link {
  color: rgba(255, 255, 255, 0.68);
  font-size: 15px;
  line-height: 1.25;
}

.footer-text {
  max-width: 230px;
}

.footer-contact__card {
  display: grid;
  grid-template-columns: 44px minmax(0, 1fr);
  gap: 16px;
  align-items: center;
  color: var(--color-white);
  margin-bottom: 18px;
}

.footer-contact__icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 38px;
  height: 38px;
  border: 1px solid rgba(255, 255, 255, 0.82);
  border-radius: 4px;
}

.footer-contact__label {
  color: var(--color-white);
  font-size: 16px;
  line-height: 1.1;
}

.footer-contact__text {
  padding-left: 60px;
}

.footer-list {
  display: grid;
  gap: 18px;
}

.footer-link {
  display: inline-block;
}

.footer-link:hover,
.footer-legal__link:hover,
.footer-contact__card:hover {
  color: var(--color-white);
  opacity: 1;
}

.footer-social__list {
  display: flex;
  gap: 12px;
  align-items: center;
}

.footer-social__link {
  display: inline-flex;
  width: 19px;
  height: 19px;
  color: rgba(255, 255, 255, 0.78);
}

.footer-social__link:hover {
  color: var(--color-white);
  opacity: 1;
}

.footer-social__link svg {
  width: 100%;
  height: 100%;
}

.site-footer__bottom {
  display: grid;
  grid-template-columns: minmax(260px, 1.4fr) minmax(160px, 0.55fr) minmax(160px, 0.55fr) minmax(220px, 0.7fr);
  gap: var(--space-8);
  align-items: center;
  border-top: 1px solid rgba(255, 255, 255, 0.24);
  margin-top: 78px;
  padding-top: 40px;
}

.footer-legal {
  display: flex;
  flex-wrap: wrap;
  gap: 0;
}

.footer-legal__link:not(:last-child)::after {
  content: "|";
  display: inline-block;
  margin: 0 14px;
  color: rgba(255, 255, 255, 0.7);
}

.footer-badges .footer-title {
  margin-bottom: 16px;
}

.footer-badges__row {
  display: flex;
  gap: 8px;
  align-items: center;
}

.footer-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 50px;
  height: 30px;
  padding: 0 8px;
  border-radius: 3px;
  background: var(--color-white);
  color: var(--color-black);
  font-size: 11px;
  font-weight: var(--font-weight-bold);
  line-height: 1;
}

.footer-badge--visa { color: #164da1; font-size: 14px; }
.footer-badge--mc { color: #e0442f; }
.footer-badge--amex { color: #2286bd; }
.footer-badge--dhl { background: #ffcc00; color: #d40511; font-style: italic; font-size: 14px; }
.footer-badge--ship { color: #2361ad; }

.footer-locale {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 44px;
  border: 1px solid rgba(255, 255, 255, 0.82);
  padding: 0 14px;
  color: var(--color-white);
  font-size: 14px;
}

@media (max-width: 1024px) {
  .site-footer__top {
    grid-template-columns: repeat(3, 1fr);
  }

  .site-footer__bottom {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 768px) {
  .site-footer {
    padding: 48px 0 42px;
  }

  .site-footer__top,
  .site-footer__bottom {
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .site-footer__bottom {
    margin-top: 48px;
    padding-top: 32px;
  }

  .footer-contact__text {
    padding-left: 0;
  }

  .footer-text {
    max-width: none;
  }
}
{% endstylesheet %}

