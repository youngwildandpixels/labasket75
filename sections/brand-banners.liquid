{%- comment -%}
  Brand Banners — 1 grande bannière + jusqu'à 3 petites bannières
  Blocks : block 0 = grande bannière, blocks 1 à 3 = petites bannières empilées
{%- endcomment -%}

{%- liquid
  assign small_count = section.blocks.size | minus: 1
  if small_count < 1
    assign small_count = 1
  endif
  if small_count > 3
    assign small_count = 3
  endif
-%}

<section class="brand-banners">
  <div
    class="brand-banners__grid brand-banners__grid--featured-{{ section.settings.featured_position }}{% if section.blocks.size == 1 %} brand-banners__grid--single{% endif %}"
    style="--brand-banners-small-count: {{ small_count }};"
  >
    {%- for block in section.blocks -%}
      {%- liquid
        assign overlay_alpha = block.settings.overlay_opacity | times: 0.01
        assign banner_role = 'small'
        assign banner_row = forloop.index0
        if forloop.first
          assign banner_role = 'featured'
          assign banner_row = 1
        endif
      -%}
      <a
        href="{{ block.settings.link | default: routes.all_products_collection_url }}"
        class="brand-banner brand-banner--{{ banner_role }} brand-banner--{{ forloop.index0 }}"
        style="--brand-banner-overlay: {{ overlay_alpha }}; --brand-banner-row: {{ banner_row }};"
        {{ block.shopify_attributes }}
      >
        <div class="brand-banner__media">
          {%- if block.settings.image != blank -%}
            <img
              src="{{ block.settings.image | image_url: width: 1200 }}"
              srcset="{{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 1200 }} 1200w"
              sizes="(max-width: 768px) 100vw, 50vw"
              alt="{{ block.settings.brand_name | escape }}"
              loading="lazy"
              width="1200"
              height="800"
              class="brand-banner__img"
            >
          {%- else -%}
            {{ 'collection-apparel-1' | placeholder_svg_tag: 'brand-banner__img brand-banner__img--placeholder' }}
          {%- endif -%}

          <div class="brand-banner__overlay"></div>

          <div class="brand-banner__content">
            {%- if block.settings.brand_name != blank -%}
              <h3 class="brand-banner__name">{{ block.settings.brand_name }}</h3>
            {%- endif -%}
            {%- if block.settings.cta_label != blank -%}
              <span class="brand-banner__cta">{{ block.settings.cta_label }}</span>
            {%- endif -%}
          </div>
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
.brand-banners {
  width: 100%;
  padding-left: var(--surface-gap);
  padding-right: var(--surface-gap);
}

.brand-banners__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: repeat(var(--brand-banners-small-count), minmax(0, 1fr));
  gap: var(--surface-gap);
  background: transparent;
  height: 80vh;
  min-height: 500px;
}

.brand-banners__grid--single {
  grid-template-columns: 1fr;
  grid-template-rows: 1fr;
  height: 64vh;
}

.brand-banners__grid--featured-left .brand-banner--featured {
  grid-column: 1;
  grid-row: 1 / -1;
}

.brand-banners__grid--featured-left .brand-banner--small {
  grid-column: 2;
  grid-row: var(--brand-banner-row);
}

.brand-banners__grid--featured-right .brand-banner--featured {
  grid-column: 2;
  grid-row: 1 / -1;
}

.brand-banners__grid--featured-right .brand-banner--small {
  grid-column: 1;
  grid-row: var(--brand-banner-row);
}

.brand-banners__grid--single .brand-banner {
  grid-column: 1;
  grid-row: 1;
}

.brand-banner {
  display: block;
  overflow: hidden;
  position: relative;
  border-radius: var(--surface-radius);
}

.brand-banner:hover {
  opacity: 1;
}

.brand-banner__media {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  border-radius: inherit;
}

.brand-banner__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}
.brand-banner__img--placeholder {
  background: var(--color-gray-100);
}

.brand-banner__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(160deg, rgba(0,0,0,var(--brand-banner-overlay)) 0%, rgba(0,0,0,0) 68%);
  pointer-events: none;
}

.brand-banner__content {
  position: absolute;
  top: var(--space-6);
  left: var(--space-6);
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.brand-banner__name {
  font-size: clamp(28px, 4vw, 52px);
  font-weight: var(--font-weight-bold);
  color: var(--color-white);
  line-height: 1;
  letter-spacing: -0.5px;
  margin: 0;
}

.brand-banner--small .brand-banner__name {
  font-size: clamp(22px, 3vw, 40px);
}

.brand-banner__cta {
  position: relative;
  display: inline-flex;
  align-items: center;
  color: var(--color-white);
  border: 0;
  border-radius: 0;
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-semibold);
  letter-spacing: 2px;
  text-transform: uppercase;
  padding: 8px 0;
  transition: opacity 0.2s;
  width: fit-content;
}
.brand-banner__cta::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 2px;
  height: 2px;
  background: currentColor;
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.24s ease;
}
.brand-banner:hover .brand-banner__cta {
  opacity: 1;
}
.brand-banner:hover .brand-banner__cta::after {
  transform: scaleX(1);
}

/* Mobile — empilés verticalement */
@media (max-width: 768px) {
  .brand-banners {
    padding: var(--space-2);
  }

  .brand-banners__grid {
    grid-template-columns: 1fr;
    grid-template-rows: auto;
    height: auto;
  }

  .brand-banners__grid--featured-left .brand-banner--featured,
  .brand-banners__grid--featured-left .brand-banner--small,
  .brand-banners__grid--featured-right .brand-banner--featured,
  .brand-banners__grid--featured-right .brand-banner--small,
  .brand-banners__grid--single .brand-banner {
    grid-column: 1;
    grid-row: auto;
  }

  .brand-banner__media {
    aspect-ratio: 4 / 3;
  }

  .brand-banner__name { font-size: 32px; }
  .brand-banner--small .brand-banner__name { font-size: 32px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Brand Banners",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "featured_position",
      "label": "Position du grand bloc",
      "default": "left",
      "options": [
        { "value": "left", "label": "À gauche" },
        { "value": "right", "label": "À droite" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Marque",
      "settings": [
        { "type": "image_picker", "id": "image",      "label": "Image" },
        { "type": "text",         "id": "brand_name", "label": "Nom de la marque", "default": "Marque" },
        { "type": "text",         "id": "cta_label",  "label": "Texte du bouton",  "default": "Découvrir" },
        { "type": "url",          "id": "link",       "label": "Lien collection" },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Niveau de l'overlay",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "default": 35
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{
    "name": "Brand Banners",
    "blocks": [
      { "type": "brand", "settings": { "brand_name": "Salomon",     "cta_label": "Découvrir" } },
      { "type": "brand", "settings": { "brand_name": "Birkenstock", "cta_label": "Découvrir" } },
      { "type": "brand", "settings": { "brand_name": "Nike",        "cta_label": "Découvrir" } }
    ]
  }]
}
{% endschema %}
