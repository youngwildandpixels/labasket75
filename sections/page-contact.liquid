{%- comment -%} Page Contact — formulaire et informations boutique {%- endcomment -%}

<section class="contact-page" id="contact-page-{{ section.id }}">
  <div class="contact-page__inner container">
    <div class="contact-page__grid">
      <div class="contact-page__form-panel">
        <header class="contact-page__hero">
          <h1 class="contact-page__title">{{ section.settings.title | default: 'Formulaire de contact' }}</h1>
          {%- if section.settings.intro != blank -%}
            <div class="contact-page__intro">{{ section.settings.intro }}</div>
          {%- endif -%}

          <div class="contact-page__socials" aria-label="Réseaux sociaux">
            {%- if section.settings.facebook_link != blank -%}
              <a href="{{ section.settings.facebook_link }}" class="contact-page__social" target="_blank" rel="noopener" aria-label="Facebook">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14 8h3V4h-3c-3.3 0-5 2-5 5v3H6v4h3v8h4v-8h3.4l.6-4h-4V9c0-.7.3-1 1-1Z"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.instagram_link != blank -%}
              <a href="{{ section.settings.instagram_link }}" class="contact-page__social" target="_blank" rel="noopener" aria-label="Instagram">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>
              </a>
            {%- endif -%}
            {%- if section.settings.tiktok_link != blank -%}
              <a href="{{ section.settings.tiktok_link }}" class="contact-page__social" target="_blank" rel="noopener" aria-label="TikTok">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M15.7 3c.4 3 2 4.8 5.1 5v3.4c-1.8.1-3.4-.4-5-1.5v6.3c0 7.9-8.7 10.4-12.2 4.7-2.3-3.7-.9-10.1 6.4-10.4v3.6c-.6.1-1.2.2-1.8.5-1.7.8-2.6 2.3-2.3 4 .6 3.2 6.3 4.2 6.8-1.1V3h3Z"/></svg>
              </a>
            {%- endif -%}
          </div>
        </header>

        {%- form 'contact', class: 'contact-page__form' -%}
          {%- if form.posted_successfully? -%}
            <p class="contact-page__success" tabindex="-1" autofocus>{{ section.settings.success_message }}</p>
          {%- endif -%}

          {%- if form.errors -%}
            <div class="contact-page__errors" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="contact-page__fields">
            <label>
              <span>Nom</span>
              <input type="text" name="contact[name]" value="{% if form.name %}{{ form.name }}{% endif %}" autocomplete="name">
            </label>
            <label>
              <span>Email</span>
              <input type="email" name="contact[email]" value="{% if form.email %}{{ form.email }}{% endif %}" autocomplete="email" required>
            </label>
            <label>
              <span>Message</span>
              <textarea name="contact[body]" rows="7" required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
            </label>
          </div>

          <button type="submit" class="contact-page__submit">Envoyer</button>
        {%- endform -%}
      </div>

      <aside class="contact-page__info">
        <div class="contact-page__info-block">
          <span>Boutique</span>
          <p>{{ section.settings.address }}</p>
          {%- if section.settings.map_link != blank -%}
            <a href="{{ section.settings.map_link }}" target="_blank" rel="noopener">Ouvrir l'itinéraire</a>
          {%- endif -%}
        </div>
        <div class="contact-page__info-block">
          <span>Horaires</span>
          <p>{{ section.settings.hours }}</p>
        </div>
        <div class="contact-page__info-block">
          <span>Email</span>
          <p><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></p>
        </div>
        {%- if section.settings.instagram_label != blank -%}
          <div class="contact-page__info-block">
            <span>Instagram</span>
            <p><a href="{{ section.settings.instagram_link }}" target="_blank" rel="noopener">{{ section.settings.instagram_label }}</a></p>
          </div>
        {%- endif -%}
      </aside>
    </div>
  </div>
</section>

{% stylesheet %}
.contact-page {
  background: var(--color-white);
  color: var(--color-black);
  padding: var(--space-16) 0 var(--space-16);
}

.contact-page__inner {
  max-width: 1180px;
}

.contact-page__info-block span,
.contact-page__fields span {
  color: var(--color-black);
  font-size: 15px;
  font-weight: var(--font-weight-semibold);
  letter-spacing: 0;
  margin: 0;
}

.contact-page__title {
  font-size: clamp(48px, 7.4vw, 86px);
  font-weight: var(--font-weight-bold);
  line-height: 0.98;
  letter-spacing: 0;
  margin: 0;
  text-align: center;
}

.contact-page__intro {
  color: var(--color-black);
  font-size: 16px;
  line-height: 1.45;
  margin: var(--space-5) auto 0;
  text-align: center;
}

.contact-page__intro p {
  margin: 0;
}

.contact-page__socials {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: var(--space-6);
  margin-top: var(--space-8);
}

.contact-page__social {
  width: 21px;
  height: 21px;
  color: var(--color-black);
  display: inline-flex;
}

.contact-page__social:hover {
  opacity: 0.65;
}

.contact-page__social svg {
  width: 100%;
  height: 100%;
}

.contact-page__grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(260px, 300px);
  gap: var(--space-12);
  align-items: start;
}

.contact-page__form-panel {
  display: grid;
  gap: var(--space-8);
}

.contact-page__form {
  display: grid;
  gap: var(--space-5);
}

.contact-page__fields {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--space-5);
}

.contact-page__fields label {
  display: grid;
  gap: var(--space-2);
}

.contact-page__fields label:last-child {
  grid-column: 1 / -1;
}

.contact-page__fields input,
.contact-page__fields textarea {
  width: 100%;
  border: 1.25px solid var(--color-black);
  border-radius: 18px;
  background: var(--color-white);
  color: var(--color-black);
  font: inherit;
  padding: 12px 16px;
}

.contact-page__fields input {
  min-height: 42px;
}

.contact-page__fields textarea {
  min-height: 164px;
  resize: vertical;
}

.contact-page__submit {
  position: relative;
  justify-self: center;
  min-width: 0;
  min-height: 36px;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: var(--color-black);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 8px 0;
  font-weight: var(--font-weight-medium);
}

.contact-page__submit::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 2px;
  height: 2px;
  background: currentColor;
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.24s ease;
}

.contact-page__submit:hover {
  opacity: 1;
}
.contact-page__submit:hover::after,
.contact-page__submit:focus-visible::after { transform: scaleX(1); }

.contact-page__success,
.contact-page__errors {
  border: 1.5px solid var(--color-black);
  margin: 0;
  padding: var(--space-4);
}

.contact-page__info {
  display: grid;
  border: 1.5px solid var(--color-black);
  border-radius: 18px;
  overflow: hidden;
}

.contact-page__info-block {
  padding: var(--space-5);
  border-bottom: 1px solid var(--color-gray-200);
}

.contact-page__info-block:last-child {
  border-bottom: 0;
}

.contact-page__info-block p {
  color: var(--color-gray-700);
  font-size: 15px;
  line-height: 1.55;
  margin: 0;
  white-space: pre-line;
}

.contact-page__info-block a {
  color: var(--color-black);
  text-decoration: underline;
  text-underline-offset: 3px;
}

@media (max-width: 900px) {
  .contact-page {
    padding: var(--space-10) 0 var(--space-12);
  }

  .contact-page__grid,
  .contact-page__fields {
    grid-template-columns: 1fr;
  }

  .contact-page__title {
    font-size: 44px;
    text-align: left;
  }

  .contact-page__intro {
    margin-left: 0;
    text-align: left;
  }

  .contact-page__socials {
    justify-content: flex-start;
  }

  .contact-page__fields input,
  .contact-page__fields textarea {
    border-radius: 16px;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Page contact",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Titre", "default": "Formulaire de contact" },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Introduction",
      "default": "<p>Renseignez le formulaire ci-dessous pour nous envoyer un message !</p>"
    },
    { "type": "text", "id": "success_message", "label": "Message de confirmation", "default": "Merci, ton message a bien été envoyé." },
    { "type": "textarea", "id": "address", "label": "Adresse", "default": "14 Rue Saint-Esprit\nClermont-Ferrand" },
    { "type": "textarea", "id": "hours", "label": "Horaires", "default": "Lundi 14h-19h\nMardi au samedi 11h-19h" },
    { "type": "text", "id": "email", "label": "Email", "default": "contact@kozysneakers.fr" },
    { "type": "url", "id": "map_link", "label": "Lien Google Maps" },
    { "type": "text", "id": "instagram_label", "label": "Libellé Instagram", "default": "@kozysneakers" },
    { "type": "url", "id": "instagram_link", "label": "Lien Instagram" },
    { "type": "url", "id": "facebook_link", "label": "Lien Facebook" },
    { "type": "url", "id": "tiktok_link", "label": "Lien TikTok" }
  ],
  "presets": [
    { "name": "Page contact" }
  ]
}
{% endschema %}
