{%- comment -%}
  Google Reviews — met en avant des avis Google depuis des metaobjects.

  Metaobject recommande : google_review
  Champs : reviewer_name, rating, body, date, location, review_url
{%- endcomment -%}
{%- liquid
  assign source = section.settings.source
  assign metaobject_type = section.settings.metaobject_type | default: 'google_review'
  assign reviews_limit = section.settings.reviews_to_show
  assign google_reviews = shop.metaobjects[metaobject_type].values
  assign has_metaobject_reviews = false

  if source == 'metaobjects' and google_reviews != blank
    assign has_metaobject_reviews = true
  endif
-%}

<section class="google-reviews" id="GoogleReviews-{{ section.id }}">
  <div class="google-reviews__inner container">
    <div class="google-reviews__head">
      <div>
        {%- if section.settings.kicker != blank -%}
          <p class="google-reviews__kicker">{{ section.settings.kicker }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="google-reviews__title">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </div>

      <div class="google-reviews__summary" aria-label="{{ section.settings.average_rating }} sur 5 sur Google">
        <span class="google-reviews__google">Google</span>
        <span class="google-reviews__score">{{ section.settings.average_rating }}</span>
        <span class="google-reviews__stars" aria-hidden="true">
          {%- for i in (1..5) -%}
            <span class="google-reviews__star">★</span>
          {%- endfor -%}
        </span>
        {%- if section.settings.review_count != blank -%}
          <span class="google-reviews__count">{{ section.settings.review_count }}</span>
        {%- endif -%}
      </div>
    </div>

    <div class="google-reviews__grid">
      {%- if has_metaobject_reviews -%}
        {%- for review in google_reviews limit: reviews_limit -%}
          {%- liquid
            assign reviewer_name = review.reviewer_name.value | default: review.reviewer_name
            assign rating = review.rating.value | default: review.rating | default: 5 | plus: 0
            assign body = review.body.value | default: review.body
            assign date = review.date.value | default: review.date
            assign location = review.location.value | default: review.location
            assign review_url = review.review_url.value | default: review.review_url
          -%}
          <article class="google-review" {{ review.shopify_attributes }}>
            <div class="google-review__top">
              <div>
                <h3 class="google-review__name">{{ reviewer_name | default: 'Client Google' }}</h3>
                {%- if date != blank or location != blank -%}
                  <p class="google-review__meta">
                    {%- if date != blank -%}{{ date }}{%- endif -%}
                    {%- if date != blank and location != blank -%}<span aria-hidden="true"> · </span>{%- endif -%}
                    {%- if location != blank -%}{{ location }}{%- endif -%}
                  </p>
                {%- endif -%}
              </div>
              <span class="google-review__badge" aria-hidden="true">G</span>
            </div>
            <div class="google-review__stars" aria-label="{{ rating }} sur 5">
              {%- for i in (1..5) -%}
                <span class="{% if i <= rating %}is-filled{% endif %}">★</span>
              {%- endfor -%}
            </div>
            {%- if body != blank -%}
              <div class="google-review__body">{{ body }}</div>
            {%- endif -%}
            {%- if review_url != blank -%}
              <a href="{{ review_url }}" class="google-review__link" target="_blank" rel="noopener">Lire sur Google</a>
            {%- endif -%}
          </article>
        {%- endfor -%}
      {%- else -%}
        {%- for block in section.blocks limit: reviews_limit -%}
          {%- if block.type == 'review' -%}
            {%- assign rating = block.settings.rating | plus: 0 -%}
            <article class="google-review" {{ block.shopify_attributes }}>
              <div class="google-review__top">
                <div>
                  <h3 class="google-review__name">{{ block.settings.reviewer_name | default: 'Client Google' }}</h3>
                  {%- if block.settings.date != blank or block.settings.location != blank -%}
                    <p class="google-review__meta">
                      {%- if block.settings.date != blank -%}{{ block.settings.date }}{%- endif -%}
                      {%- if block.settings.date != blank and block.settings.location != blank -%}<span aria-hidden="true"> · </span>{%- endif -%}
                      {%- if block.settings.location != blank -%}{{ block.settings.location }}{%- endif -%}
                    </p>
                  {%- endif -%}
                </div>
                <span class="google-review__badge" aria-hidden="true">G</span>
              </div>
              <div class="google-review__stars" aria-label="{{ rating }} sur 5">
                {%- for i in (1..5) -%}
                  <span class="{% if i <= rating %}is-filled{% endif %}">★</span>
                {%- endfor -%}
              </div>
              {%- if block.settings.body != blank -%}
                <div class="google-review__body">{{ block.settings.body }}</div>
              {%- endif -%}
              {%- if block.settings.review_url != blank -%}
                <a href="{{ block.settings.review_url }}" class="google-review__link" target="_blank" rel="noopener">Lire sur Google</a>
              {%- endif -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
      <div class="google-reviews__actions">
        <a href="{{ section.settings.cta_link }}" class="btn btn--secondary" target="_blank" rel="noopener">
          {{ section.settings.cta_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.google-reviews {
  padding: var(--space-16) 0;
  border-top: 1px solid var(--color-gray-200);
  background: var(--color-white);
}

.google-reviews__inner {
  display: flex;
  flex-direction: column;
  gap: var(--space-8);
}

.google-reviews__head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: var(--space-6);
}

.google-reviews__kicker {
  margin: 0 0 var(--space-2);
  color: var(--color-gray-500);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-semibold);
  letter-spacing: 2px;
  text-transform: uppercase;
}

.google-reviews__title {
  max-width: 720px;
  margin: 0;
  font-size: clamp(28px, 4vw, 48px);
  font-weight: var(--font-weight-bold);
  line-height: 1;
  letter-spacing: -1px;
}

.google-reviews__summary {
  display: grid;
  grid-template-columns: auto auto;
  align-items: center;
  gap: 2px var(--space-3);
  flex: 0 0 auto;
  padding: var(--space-4);
  border: 1px solid var(--color-gray-200);
}

.google-reviews__google {
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-semibold);
  letter-spacing: 1.4px;
  text-transform: uppercase;
}

.google-reviews__score {
  justify-self: end;
  font-size: 22px;
  font-weight: var(--font-weight-bold);
  line-height: 1;
}

.google-reviews__stars {
  display: flex;
  gap: 1px;
  color: #fbbc04;
  font-size: 14px;
  line-height: 1;
}

.google-reviews__count {
  justify-self: end;
  color: var(--color-gray-500);
  font-size: var(--font-size-small);
}

.google-reviews__grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--space-4);
}

.google-review {
  display: flex;
  min-height: 260px;
  flex-direction: column;
  gap: var(--space-4);
  padding: var(--space-5);
  border: 1px solid var(--color-gray-200);
  background: var(--color-white);
}

.google-review__top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--space-4);
}

.google-review__name {
  margin: 0;
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-semibold);
  line-height: 1.25;
}

.google-review__meta {
  margin: var(--space-1) 0 0;
  color: var(--color-gray-500);
  font-size: var(--font-size-small);
  line-height: 1.35;
}

.google-review__badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  flex: 0 0 28px;
  border: 1px solid var(--color-gray-200);
  border-radius: 50%;
  font-size: var(--font-size-small);
  font-weight: var(--font-weight-bold);
}

.google-review__stars {
  display: flex;
  gap: 1px;
  color: var(--color-gray-300);
  font-size: 15px;
  line-height: 1;
}

.google-review__stars .is-filled {
  color: #fbbc04;
}

.google-review__body {
  color: var(--color-gray-700);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-light);
  line-height: 1.65;
}

.google-review__body p {
  margin: 0;
}

.google-review__link {
  width: fit-content;
  margin-top: auto;
  border-bottom: 1px solid currentColor;
  font-size: var(--font-size-small);
  font-weight: var(--font-weight-medium);
  line-height: 1.2;
}

.google-reviews__actions {
  display: flex;
  justify-content: center;
}

@media (max-width: 1024px) {
  .google-reviews__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 768px) {
  .google-reviews {
    padding: var(--space-10) 0;
  }

  .google-reviews__head {
    align-items: flex-start;
    flex-direction: column;
  }

  .google-reviews__summary {
    width: 100%;
  }

  .google-reviews__grid {
    display: flex;
    gap: var(--space-3);
    margin: 0 calc(var(--container-padding) * -1);
    overflow-x: auto;
    padding: 0 var(--container-padding) var(--space-2);
    scroll-snap-type: x mandatory;
  }

  .google-review {
    min-width: 82vw;
    min-height: 250px;
    scroll-snap-align: start;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Google Reviews",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "source",
      "label": "Source des avis",
      "default": "metaobjects",
      "options": [
        { "value": "metaobjects", "label": "Metaobjects" },
        { "value": "blocks", "label": "Blocs manuels" }
      ]
    },
    {
      "type": "text",
      "id": "metaobject_type",
      "label": "Handle du metaobject",
      "default": "google_review",
      "info": "Doit correspondre au type de metaobject dans l'admin Shopify."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Petit label",
      "default": "Avis Google"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Ils nous recommandent"
    },
    {
      "type": "text",
      "id": "average_rating",
      "label": "Note moyenne",
      "default": "4.9"
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Nombre d'avis",
      "default": "+100 avis"
    },
    {
      "type": "range",
      "id": "reviews_to_show",
      "label": "Avis à afficher",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Texte du bouton",
      "default": "Voir tous les avis"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Lien Google Reviews"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Avis manuel",
      "settings": [
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Nom",
          "default": "Client Google"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Note",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "richtext",
          "id": "body",
          "label": "Commentaire",
          "default": "<p>Super boutique, équipe accueillante et très bons conseils.</p>"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date",
          "default": "Il y a 2 semaines"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Ville"
        },
        {
          "type": "url",
          "id": "review_url",
          "label": "Lien de l'avis"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Google Reviews",
      "blocks": [
        { "type": "review" },
        { "type": "review", "settings": { "reviewer_name": "Client Google", "date": "Il y a 1 mois", "body": "<p>Très bonne expérience, livraison rapide et produit conforme.</p>" } },
        { "type": "review", "settings": { "reviewer_name": "Client Google", "date": "Il y a 3 mois", "body": "<p>Accueil au top et sélection de sneakers vraiment soignée.</p>" } }
      ]
    }
  ]
}
{% endschema %}
