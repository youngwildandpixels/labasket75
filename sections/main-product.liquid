  }

}
{% endstylesheet %}

<script>
(function () {
  var section = document.getElementById('product-section-{{ section.id }}');
  if (!section) return;

  // Variant selector
  var radios = section.querySelectorAll('[data-variant-radio]');
  var hiddenInput = section.querySelector('[data-variant-id]');
  var cells = section.querySelectorAll('.size-cell');

  radios.forEach(function (radio) {
    radio.addEventListener('change', function () {
      if (hiddenInput) hiddenInput.value = radio.value;
      cells.forEach(function (c) { c.classList.remove('is-selected'); });
      var cell = radio.closest('.size-cell');
      if (cell) cell.classList.add('is-selected');
      var url = new URL(window.location);
      url.searchParams.set('variant', radio.value);
      window.history.replaceState({}, '', url);
    });
  });

  // Gallery thumbnails
  var thumbs = section.querySelectorAll('.pgallery__thumb');
  var thumbsTrack = section.querySelector('[data-gallery-thumbs]');
  var thumbsPrev = section.querySelector('[data-gallery-thumbs-prev]');
  var thumbsNext = section.querySelector('[data-gallery-thumbs-next]');
  var dots = section.querySelectorAll('[data-gallery-dot]');
  var mobilePrev = section.querySelector('[data-gallery-mobile-prev]');
  var mobileNext = section.querySelector('[data-gallery-mobile-next]');
  var mainImg = section.querySelector('#pgallery-main-{{ section.id }}');
  var zoomButton = section.querySelector('[data-gallery-zoom]');
  var modal = section.querySelector('[data-gallery-modal]');
  var modalImg = section.querySelector('[data-gallery-modal-img]');
  var closeButtons = section.querySelectorAll('[data-gallery-close]');
  var sizeGuideOpen = section.querySelector('[data-size-guide-open]');
  var sizeGuideModal = section.querySelector('[data-size-guide-modal]');
  var sizeGuideCloseButtons = section.querySelectorAll('[data-size-guide-close]');
  var sizeGuideBody = section.querySelector('[data-size-guide-body]');

  function setZoomImage(src) {
    if (!modalImg || !src) return;
    modalImg.src = src;
  }

  function openZoom() {
    if (!modal || !modalImg || !mainImg) return;
    setZoomImage(mainImg.dataset.zoomSrc || mainImg.currentSrc || mainImg.src);
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
    document.documentElement.style.overflow = 'hidden';
  }

  function closeZoom() {
    if (!modal) return;
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
    document.documentElement.style.overflow = '';
  }

  function openSizeGuide() {
    if (!sizeGuideModal) return;
    sizeGuideModal.classList.add('is-open');
    sizeGuideModal.setAttribute('aria-hidden', 'false');
    document.documentElement.style.overflow = 'hidden';
  }

  function closeSizeGuide() {
    if (!sizeGuideModal) return;
    sizeGuideModal.classList.remove('is-open');
    sizeGuideModal.setAttribute('aria-hidden', 'true');
    document.documentElement.style.overflow = '';
  }

  function updateThumbArrows() {
    if (!thumbsTrack || !thumbsPrev || !thumbsNext) return;
    var maxScroll = thumbsTrack.scrollWidth - thumbsTrack.clientWidth;
    var hasOverflow = maxScroll > 2;
    thumbsPrev.hidden = !hasOverflow;
    thumbsNext.hidden = !hasOverflow;
    thumbsPrev.disabled = !hasOverflow || thumbsTrack.scrollLeft <= 2;
    thumbsNext.disabled = !hasOverflow || thumbsTrack.scrollLeft >= maxScroll - 2;
  }

  function scrollActiveThumb(thumb) {
    if (!thumb || !thumbsTrack) return;
    thumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
    window.setTimeout(updateThumbArrows, 220);
  }

  function scrollThumbs(direction) {
    if (!thumbsTrack) return;
    var amount = Math.max(thumbsTrack.clientWidth * 0.75, 120);
    thumbsTrack.scrollBy({ left: direction * amount, behavior: 'smooth' });
    window.setTimeout(updateThumbArrows, 240);
  }

  function getActiveIndex() {
    var active = section.querySelector('.pgallery__thumb.is-active');
    if (!active) return 0;
    return parseInt(active.dataset.galleryIndex || '0', 10);
  }

  function setActiveImage(index) {
    if (!thumbs.length) return;
    var nextIndex = (index + thumbs.length) % thumbs.length;
    var thumb = thumbs[nextIndex];
    if (!thumb) return;
    thumbs.forEach(function (x) { x.classList.remove('is-active'); });
    dots.forEach(function (dot) {
      var isActive = parseInt(dot.dataset.galleryIndex || '0', 10) === nextIndex;
      dot.classList.toggle('is-active', isActive);
      if (isActive) {
        dot.setAttribute('aria-current', 'true');
      } else {
        dot.removeAttribute('aria-current');
      }
    });
    thumb.classList.add('is-active');
    var src = thumb.dataset.imageSrc;
    if (src && mainImg) {
      mainImg.src = src;
      if (thumb.dataset.imageSrcset) mainImg.srcset = thumb.dataset.imageSrcset;
      mainImg.dataset.zoomSrc = thumb.dataset.zoomSrc || src;
      setZoomImage(mainImg.dataset.zoomSrc);
    }
    scrollActiveThumb(thumb);
  }

  thumbs.forEach(function (t) {
    t.addEventListener('click', function () {
      setActiveImage(parseInt(t.dataset.galleryIndex || '0', 10));
    });
  });

  dots.forEach(function (dot) {
    dot.addEventListener('click', function () {
      setActiveImage(parseInt(dot.dataset.galleryIndex || '0', 10));
    });
  });

  if (mobilePrev) {
    mobilePrev.addEventListener('click', function () {
      setActiveImage(getActiveIndex() - 1);
    });
  }

  if (mobileNext) {
    mobileNext.addEventListener('click', function () {
      setActiveImage(getActiveIndex() + 1);
    });
  }

  if (thumbsPrev) {
    thumbsPrev.addEventListener('click', function () { scrollThumbs(-1); });
  }

  if (thumbsNext) {
    thumbsNext.addEventListener('click', function () { scrollThumbs(1); });
  }

  if (thumbsTrack) {
    thumbsTrack.addEventListener('scroll', updateThumbArrows, { passive: true });
    window.addEventListener('resize', updateThumbArrows);
    updateThumbArrows();
  }

  if (zoomButton) {
    zoomButton.addEventListener('click', openZoom);
  }

  closeButtons.forEach(function (button) {
    button.addEventListener('click', closeZoom);
  });

  if (sizeGuideOpen) {
    sizeGuideOpen.addEventListener('click', openSizeGuide);
  }

  sizeGuideCloseButtons.forEach(function (button) {
    button.addEventListener('click', closeSizeGuide);
  });

  document.addEventListener('keydown', function (event) {
    if (event.key === 'Escape') {
      closeZoom();
      closeSizeGuide();
    }
  });

  // Size unit conversion
  var unitBtns = section.querySelectorAll('.size-unit');
  var sizeLabels = section.querySelectorAll('.size-cell__size');
  var productTitle = {{ product.title | json }}.toLowerCase();
  var productVendor = {{ product.vendor | json }}.toLowerCase();
  var productSizingText = productVendor + ' ' + productTitle;
  var usesThirdEuSizing = /adidas|yeezy|samba|gazelle|spezial|campus|superstar|handball|forum|ozweego|ultraboost/.test(productSizingText);
  var sizeProfile = productTitle.indexOf('(w)') !== -1 || productTitle.indexOf("women") !== -1 || productTitle.indexOf("femme") !== -1
    ? 'women'
    : productTitle.indexOf('(gs)') !== -1 || productTitle.indexOf("grade school") !== -1
      ? 'gs'
      : 'men';
  var sizeMap = {
    '35': { US: '3', UK: '2.5', CM: '22' },
    '35.5': { US: '3.5', UK: '3', CM: '22.5' },
    '36': { US: '4', UK: '3.5', CM: '23' },
