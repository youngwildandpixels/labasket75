{%- comment -%}
  Main Product — fiche produit reprenant le design de thelaststep.fr
  Galerie gauche, infos droite (taille + prix par variante)
{%- endcomment -%}
{%- liquid
  assign current = product.selected_or_first_available_variant
  assign first_col = product.collections.first
  assign product_form_id = 'product-form-' | append: section.id
  assign product_type_downcase = product.type | downcase
  assign is_sneaker = false
  if product_type_downcase == 'sneakers'
    assign is_sneaker = true
  endif
  assign fulfillment_type = product.metafields.custom.fulfillment_type.value | default: product.metafields.custom.fulfillment_type
  assign style_id = product.metafields.custom.style_id.value | default: product.metafields.custom.style_id
  if style_id == blank and product.description contains 'Style ID'
    assign style_id_parts = product.description | split: 'Style ID'
    assign style_id_after_label = style_id_parts[1] | strip_html | replace: ':', '' | strip
    assign style_id = style_id_after_label | split: ' ' | first
  endif
  assign fulfillment_type_downcase = fulfillment_type | downcase
  assign is_partner_sourced = false
  if fulfillment_type_downcase == 'scraper' or fulfillment_type_downcase == 'partner' or fulfillment_type_downcase == 'revendeur'
    assign is_partner_sourced = true
  endif
  if product.tags contains 'stockx-sync' or product.tags contains 'scraper' or product.tags contains 'livraison-5-12' or product.tags contains 'revendeur-partenaire'
    assign is_partner_sourced = true
  endif
  assign pickup_available = false
  if current.available and is_partner_sourced == false
    assign pickup_available = true
  endif
  assign size_option_position = 0
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name contains 'taille' or option_name contains 'size' or option_name contains 'pointure'
      assign size_option_position = option.position
    endif
  endfor
-%}

<section class="pmain" id="product-section-{{ section.id }}">
  <div class="pmain__layout container">
    {%- comment -%} ── GALLERY ── {%- endcomment -%}
    <div class="pgallery">
      <nav class="breadcrumb" aria-label="Fil d'Ariane">
        <a href="{{ routes.root_url }}">Accueil</a>
        {%- if first_col != blank -%}
          <span class="breadcrumb__sep">›</span>
          <a href="{{ first_col.url }}">{{ first_col.title }}</a>
        {%- endif -%}
        {%- if product.vendor != blank -%}
          <span class="breadcrumb__sep">›</span>
          <span>{{ product.vendor }}</span>
        {%- endif -%}
        <span class="breadcrumb__sep">›</span>
        <span class="breadcrumb__current">{{ product.title }}</span>
      </nav>

      <div class="pgallery__main">
        {%- if product.compare_at_price > product.price -%}
          <span class="badge badge--promo pgallery__badge">PROMO</span>
        {%- endif -%}

        {%- if product.featured_image != blank -%}
          <img
            src="{{ product.featured_image | image_url: width: 1200 }}"
            srcset="{{ product.featured_image | image_url: width: 600 }} 600w, {{ product.featured_image | image_url: width: 1200 }} 1200w"
            sizes="(max-width: 768px) 100vw, 50vw"
            alt="{{ product.featured_image.alt | default: product.title | escape }}"
            loading="eager"
            width="1200"
            height="1200"
            class="pgallery__main-img"
            id="pgallery-main-{{ section.id }}"
            data-zoom-src="{{ product.featured_image | image_url: width: 1800 }}"
          >
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'pgallery__main-img' }}
        {%- endif -%}

        <button class="pgallery__expand" aria-label="Agrandir l'image" type="button" data-gallery-zoom>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
          </svg>
        </button>

        {%- if product.images.size > 1 -%}
          <div class="pgallery__mobile-controls" aria-label="Images produit">
            <button class="pgallery__mobile-arrow" type="button" data-gallery-mobile-prev aria-label="Image précédente">
              <svg width="16" height="16" viewBox="0 0 18 18" aria-hidden="true">
                <path d="M11.5 3.5L6 9l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <div class="pgallery__dots" data-gallery-dots>
              {%- for image in product.images limit: 8 -%}
                <button
                  class="pgallery__dot{% if forloop.first %} is-active{% endif %}"
                  type="button"
                  data-gallery-dot
                  data-gallery-index="{{ forloop.index0 }}"
                  aria-label="Afficher l'image {{ forloop.index }}"
                  {% if forloop.first %}aria-current="true"{% endif %}
                ></button>
              {%- endfor -%}
            </div>
            <button class="pgallery__mobile-arrow" type="button" data-gallery-mobile-next aria-label="Image suivante">
              <svg width="16" height="16" viewBox="0 0 18 18" aria-hidden="true">
                <path d="M6.5 3.5L12 9l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>
        {%- endif -%}
      </div>

      {%- if product.images.size > 1 -%}
        <div class="pgallery__thumbs-wrap" data-gallery-thumbs-wrap>
          <button class="pgallery__thumb-arrow pgallery__thumb-arrow--prev" type="button" data-gallery-thumbs-prev aria-label="Images précédentes">
            <svg width="16" height="16" viewBox="0 0 18 18" aria-hidden="true">
              <path d="M11.5 3.5L6 9l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="pgallery__thumbs" data-gallery-thumbs>
            {%- for image in product.images limit: 8 -%}
              <button
                type="button"
                class="pgallery__thumb{% if forloop.first %} is-active{% endif %}"
                data-gallery-index="{{ forloop.index0 }}"
                data-image-src="{{ image | image_url: width: 1200 }}"
                data-image-srcset="{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 1200 }} 1200w"
                data-zoom-src="{{ image | image_url: width: 1800 }}"
                aria-label="Image {{ forloop.index }}"
              >
                <img
                  src="{{ image | image_url: width: 220 }}"
                  alt=""
                  loading="lazy"
                  width="220"
                  height="220"
                >
              </button>
            {%- endfor -%}
          </div>
          <button class="pgallery__thumb-arrow pgallery__thumb-arrow--next" type="button" data-gallery-thumbs-next aria-label="Images suivantes">
            <svg width="16" height="16" viewBox="0 0 18 18" aria-hidden="true">
              <path d="M6.5 3.5L12 9l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ── INFO ── {%- endcomment -%}
    <div class="pinfo">
      {%- if product.vendor != blank -%}
        <p class="pinfo__vendor">{{ product.vendor }}</p>
      {%- endif -%}

      <h1 class="pinfo__title">{{ product.title }}</h1>

      {%- if style_id != blank -%}
        <p class="pinfo__sku">SKU : {{ style_id }}</p>
      {%- endif -%}

      <div class="pinfo__units">
        <div class="pinfo__unit-switch" role="group" aria-label="Unite de taille">
          <button type="button" class="size-unit is-active" data-unit="EU" aria-pressed="true">EU</button>
          <button type="button" class="size-unit" data-unit="US" aria-pressed="false">US M</button>
          <button type="button" class="size-unit" data-unit="UK" aria-pressed="false">UK</button>
          <button type="button" class="size-unit" data-unit="CM" aria-pressed="false">CM</button>
        </div>
        {%- if is_sneaker -%}
          <button type="button" class="pinfo__size-guide" data-size-guide-open>Guide des tailles</button>
        {%- endif -%}
      </div>

      {%- form 'product', product, id: product_form_id, class: 'pform' -%}
        <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>

        {%- unless product.has_only_default_variant -%}
          <div class="size-grid" role="radiogroup" aria-label="Choix de la taille">
            {%- for variant in product.variants -%}
              {%- liquid
                assign variant_size_label = variant.title
                if size_option_position == 1
                  assign variant_size_label = variant.option1
                elsif size_option_position == 2
                  assign variant_size_label = variant.option2
                elsif size_option_position == 3
                  assign variant_size_label = variant.option3
                endif
              -%}
              <label
                class="size-cell{% unless variant.available %} is-sold-out{% endunless %}{% if variant.id == current.id %} is-selected{% endif %}"
                data-variant-id="{{ variant.id }}"
              >
                <input
                  type="radio"
                  name="variant-radio"
                  value="{{ variant.id }}"
                  {% unless variant.available %}disabled{% endunless %}
                  {% if variant.id == current.id %}checked{% endif %}
                  data-variant-radio
                  class="visually-hidden"
                >
                <span class="size-cell__dot{% if variant.available %} size-cell__dot--available{% endif %}" aria-hidden="true"></span>
                <span class="size-cell__size" data-size-source="{{ variant_size_label | escape }}">{{ variant_size_label }}</span>
                <span class="size-cell__prices">
                  {%- if variant.compare_at_price > variant.price -%}
                    <span class="size-cell__compare">{{ variant.compare_at_price | money_without_trailing_zeros }}</span>
                  {%- endif -%}
                  <span class="size-cell__price">{{ variant.price | money_without_trailing_zeros }}</span>
                </span>
              </label>
            {%- endfor -%}
          </div>
        {%- endunless -%}

        {%- if current.inventory_management == 'shopify' and current.inventory_quantity > 0 and current.inventory_quantity <= section.settings.low_stock_threshold -%}
          <p class="pinfo__stock">Plus que {{ current.inventory_quantity }} produit{% if current.inventory_quantity > 1 %}s{% endif %} en stock</p>
        {%- endif -%}

        <ul class="pinfo__shipping" aria-label="Delai de livraison">
          <li class="pinfo__shipping-option{% unless is_partner_sourced %} is-active{% else %} is-muted{% endunless %}">
            <span class="ship-dot{% unless is_partner_sourced %} ship-dot--filled{% endunless %}"></span>
            Livraison 24/48h
          </li>
          <li
            class="pinfo__shipping-option{% if is_partner_sourced %} is-active has-tooltip{% else %} is-muted{% endif %}"
            {% if is_partner_sourced %}tabindex="0" aria-describedby="shipping-tooltip-{{ section.id }}"{% endif %}
          >
            <span class="ship-dot{% if is_partner_sourced %} ship-dot--filled{% endif %}"></span>
            Livraison 5 à 12 jours
            {%- if is_partner_sourced -%}
              <span class="pinfo__shipping-tooltip" id="shipping-tooltip-{{ section.id }}" role="tooltip">
                Approvisionné via notre réseau de revendeurs partenaires. Jours ouvrés uniquement.
              </span>
            {%- endif -%}
          </li>
        </ul>

        <div class="pinfo__buttons{% if pickup_available %} has-mobile-pickup{% endif %}">
          <button type="submit" name="add" class="btn btn--primary pinfo__btn"{% unless current.available %} disabled{% endunless %}>
            {%- if current.available -%}Ajouter au panier{%- else -%}Rupture de stock{%- endif -%}
          </button>
          <button type="submit" name="properties[Mode]" value="Retrait en boutique" class="btn pinfo__btn pinfo__btn--pickup"{% unless pickup_available %} disabled{% endunless %}>
            {%- if pickup_available -%}Retirer en boutique{%- else -%}Retrait indisponible{%- endif -%}
          </button>
        </div>

      {%- endform -%}

      {%- if section.blocks.size > 0 or product.description != blank -%}
        <div class="pinfo__accordions">
          {%- if product.description != blank -%}
            <details class="acc">
              <summary class="acc__summary">
                <span>Description</span>
                <span class="acc__icon" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <polyline points="6 9 12 15 18 9"/>
                  </svg>
                </span>
              </summary>
              <div class="acc__content rte">{{ product.description }}</div>
            </details>
          {%- endif -%}

          {%- for block in section.blocks -%}
            {%- if block.type == 'accordion' -%}
              {%- assign accordion_title_downcase = block.settings.title | downcase -%}
              <details class="acc" {{ block.shopify_attributes }}>
                <summary class="acc__summary">
                  <span>{{ block.settings.title }}</span>
                  <span class="acc__icon" aria-hidden="true">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <polyline points="6 9 12 15 18 9"/>
                    </svg>
                  </span>
                </summary>
                <div class="acc__content rte">
                  {%- if accordion_title_downcase contains 'livraison' -%}
                    {%- if is_partner_sourced -%}
                      <p>Cette paire est approvisionnée via notre réseau de revendeurs partenaires. Livraison estimée sous 5 à 12 jours ouvrés.</p>
                    {%- else -%}
                      <p>Cette paire est déjà disponible en boutique. Livraison estimée sous 24/48h ouvrées.</p>
                    {%- endif -%}
                    <p>Les retours restent possibles selon nos conditions de retour.</p>
                  {%- else -%}
                    {{ block.settings.content }}
                  {%- endif -%}
                </div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if is_sneaker -%}
    <div class="size-guide-modal" aria-hidden="true" data-size-guide-modal>
      <button class="size-guide-modal__backdrop" type="button" data-size-guide-close aria-label="Fermer le guide des tailles"></button>
      <div class="size-guide-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="size-guide-title-{{ section.id }}">
        <button class="size-guide-modal__close" type="button" data-size-guide-close aria-label="Fermer le guide des tailles">
          <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
            <path d="M4 4l14 14M18 4L4 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
        </button>
        <h2 class="size-guide-modal__title" id="size-guide-title-{{ section.id }}">Guide des tailles</h2>
        <div class="size-guide-modal__table-wrap">
          <table class="size-guide-modal__table">
            <thead>
              <tr>
                <th scope="col">EU</th>
                <th scope="col">US M</th>
                <th scope="col">UK</th>
                <th scope="col">CM</th>
              </tr>
            </thead>
            <tbody data-size-guide-body></tbody>
          </table>
        </div>
      </div>
    </div>
  {%- endif -%}

  <div class="pgallery-modal" aria-hidden="true" data-gallery-modal>
    <button class="pgallery-modal__backdrop" type="button" data-gallery-close aria-label="Fermer l'image"></button>
    <div class="pgallery-modal__dialog" role="dialog" aria-modal="true" aria-label="{{ product.title | escape }}">
      <button class="pgallery-modal__close" type="button" data-gallery-close aria-label="Fermer l'image">
        <svg width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
          <path d="M4 4l14 14M18 4L4 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
      </button>
      {%- if product.featured_image != blank -%}
        <img
          src="{{ product.featured_image | image_url: width: 1800 }}"
          alt="{{ product.featured_image.alt | default: product.title | escape }}"
          width="1800"
          height="1800"
          class="pgallery-modal__img"
          data-gallery-modal-img
        >
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
.pmain {
  background-color: var(--surface-bg);
  background-image: var(--surface-bg-pattern);
  background-size: var(--surface-bg-size);
  padding: var(--surface-gap) 0 0;
  overflow-x: hidden;
  overflow-x: clip;
}

/* Breadcrumb */
.breadcrumb {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  margin: 0;
  padding: 0 0 var(--space-4);
  font-size: var(--font-size-small);
  color: var(--color-gray-500);
  flex-wrap: wrap;
}
.breadcrumb a:hover { opacity: 0.6; }
.breadcrumb__sep { color: var(--color-gray-300); }
.breadcrumb__current { color: var(--color-black); }

/* Layout */
.pmain__layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(380px, 0.72fr);
  gap: var(--surface-gap);
  align-items: flex-start;
  width: auto;
  max-width: none;
  margin: 0 var(--surface-gap);
  padding: 0;
}

@media (max-width: 1024px) {
  .pmain__layout {
    grid-template-columns: 1fr;
    gap: var(--surface-gap);
    margin-left: var(--surface-gap);
    margin-right: var(--surface-gap);
    padding-left: 0;
    padding-right: 0;
  }
}

/* ── Galerie ── */
.pgallery {
  position: sticky;
  top: calc(var(--header-height) + var(--surface-gap));
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  min-width: 0;
  padding: var(--space-5);
  background: var(--surface-card);
  border: var(--surface-border);
  border-radius: var(--surface-radius);
  box-shadow: var(--surface-shadow);
  overflow: hidden;
}

.pgallery__main {
  position: relative;
  aspect-ratio: 1 / 1;
  max-height: min(640px, calc(100vh - var(--site-header-height, var(--header-height)) - 150px));
  background: var(--color-gray-100);
  border-radius: var(--control-radius);
  overflow: hidden;
}

.pgallery__badge {
  position: absolute;
  top: var(--space-6);
  left: var(--space-6);
  z-index: 2;
  border-radius: 9999px;
  padding: 6px 14px;
}

.pgallery__main-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: clamp(var(--space-6), 4vw, var(--space-12)) var(--space-10);
}

.pgallery__expand {
  position: absolute;
  bottom: var(--space-6);
  right: var(--space-6);
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: 0;
  color: var(--color-black);
  z-index: 2;
  transition: background 0.15s;
}
.pgallery__expand:hover { background: transparent; opacity: 0.55; }

.pgallery__mobile-controls {
  display: none;
}

.pgallery__thumbs-wrap {
  position: relative;
  display: grid;
  grid-template-columns: 36px minmax(0, 1fr) 36px;
  align-items: center;
  gap: var(--space-2);
}

.pgallery__thumbs {
  display: flex;
  gap: var(--space-2);
  max-width: 100%;
  overflow-x: auto;
  scroll-behavior: smooth;
  scroll-snap-type: x proximity;
  scrollbar-width: none;
}
.pgallery__thumbs::-webkit-scrollbar { display: none; }

.pgallery__thumb-arrow {
  width: 36px;
  height: 36px;
  border: var(--surface-border);
  border-radius: 50%;
  background: var(--color-white);
  color: var(--color-black);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.15s, transform 0.15s;
}
.pgallery__thumb-arrow:hover {
  opacity: 1;
  transform: translateY(-1px);
}
.pgallery__thumb-arrow[disabled] {
  opacity: 0.25;
  pointer-events: none;
}

.pgallery__thumb {
  width: 96px;
  height: 96px;
  background: var(--color-gray-100);
  padding: var(--space-2);
  border: var(--surface-border);
  border-radius: var(--control-radius);
  cursor: pointer;
  position: relative;
  transition: opacity 0.2s;
  flex-shrink: 0;
  scroll-snap-align: center;
}
.pgallery__thumb img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.pgallery__thumb.is-active::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 2px;
  background: var(--color-black);
}

.pgallery-modal {
  position: fixed;
  inset: 0;
  z-index: 1200;
  display: none;
  align-items: center;
  justify-content: center;
  padding: var(--space-8);
}
.pgallery-modal.is-open {
  display: flex;
}
.pgallery-modal__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(255,255,255,0.82);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}
.pgallery-modal__dialog {
  position: relative;
  z-index: 1;
  width: min(92vw, 1100px);
  height: min(86vh, 900px);
  background: var(--color-gray-100);
  border: var(--surface-border);
  border-radius: var(--surface-radius);
  box-shadow: var(--surface-shadow);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pgallery-modal__img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  padding: var(--space-10);
}
.pgallery-modal__close {
  position: absolute;
  top: var(--space-5);
  right: var(--space-5);
  z-index: 2;
  width: 44px;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: var(--surface-border);
  border-radius: 50%;
  background: var(--color-white);
  color: var(--color-black);
}
.pgallery-modal__close:hover {
  opacity: 0.6;
}

@media (max-width: 1024px) {
  .pgallery { position: static; }
}

/* ── Info ── */
.pinfo {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
  width: 100%;
  max-width: none;
  justify-self: stretch;
  padding: var(--space-8);
  min-width: 0;
  background: var(--surface-card);
  border: var(--surface-border);
  border-radius: var(--surface-radius);
  box-shadow: var(--surface-shadow);
}

.pinfo__vendor {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  letter-spacing: 0;
  text-transform: uppercase;
  color: var(--color-black);
}

.pinfo__title {
  font-size: clamp(28px, 2.4vw, 32px);
  font-weight: var(--font-weight-medium);
  line-height: 1.02;
  letter-spacing: -1px;
  text-transform: uppercase;
  margin: 0;
}

.pinfo__sku {
  font-size: var(--font-size-small);
  color: var(--color-gray-500);
  letter-spacing: 1px;
}

/* Unit toggle */
.pinfo__units {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  margin-top: var(--space-4);
}

.pinfo__unit-switch {
  display: inline-flex;
  align-items: center;
  gap: 0;
  width: fit-content;
  padding: 3px;
  background: var(--color-gray-100);
  border: var(--surface-border);
  border-radius: 9999px;
}

.size-unit {
  min-height: 34px;
  padding: 0 13px;
  border: 0;
  border-radius: 9999px;
  background: transparent;
  font-size: var(--font-size-small);
  font-weight: var(--font-weight-bold);
  color: var(--color-gray-500);
  text-transform: uppercase;
  letter-spacing: 1px;
  transition: background 0.22s ease, color 0.22s ease, box-shadow 0.22s ease;
}
.size-unit.is-active {
  background: var(--color-white);
  color: var(--color-black);
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
}

.size-unit:hover,
.size-unit:focus-visible {
  color: var(--color-black);
}

.pinfo__size-guide {
  margin-left: auto;
  border: 0;
  background: none;
  color: var(--color-black);
  cursor: pointer;
  font-size: var(--font-size-small);
  padding: 0;
  text-decoration: underline;
}

.size-guide-modal {
  position: fixed;
  inset: 0;
  z-index: 1300;
  display: none;
  align-items: center;
  justify-content: center;
  padding: var(--space-8);
}

.size-guide-modal.is-open {
  display: flex;
}

.size-guide-modal__backdrop {
  position: absolute;
  inset: 0;
  background: rgba(255,255,255,0.72);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

.size-guide-modal__dialog {
  position: relative;
  z-index: 1;
  width: min(1080px, calc(100vw - var(--space-10)));
  max-height: min(800px, calc(100vh - var(--space-12)));
  background: var(--color-white);
  padding: var(--space-10);
  border: var(--surface-border);
  border-radius: var(--surface-radius);
  box-shadow: var(--surface-shadow);
  overflow: hidden;
}

.size-guide-modal__close {
  position: absolute;
  top: var(--space-4);
  right: var(--space-4);
  width: 34px;
  height: 34px;
  display: flex;
  align-items: center;
  justify-content: center;
  border: var(--surface-border);
  border-radius: 50%;
  background: var(--color-white);
  color: var(--color-black);
}

.size-guide-modal__close:hover {
  opacity: 0.6;
}

.size-guide-modal__title {
  margin: 0 0 var(--space-6);
  font-size: 28px;
  font-weight: var(--font-weight-bold);
  letter-spacing: 0;
}

.size-guide-modal__table-wrap {
  max-height: min(620px, calc(100vh - 240px));
  overflow: auto;
  border: var(--surface-border);
  border-radius: var(--control-radius);
  box-shadow: none;
}

.size-guide-modal__table {
  width: 100%;
  border-collapse: collapse;
  font-size: var(--font-size-body);
}

.size-guide-modal__table th {
  position: sticky;
  top: 0;
  z-index: 1;
  background: var(--color-black);
  color: var(--color-white);
  font-weight: var(--font-weight-bold);
}

.size-guide-modal__table th,
.size-guide-modal__table td {
  padding: var(--space-4);
  border-bottom: 1px solid var(--color-gray-200);
  text-align: center;
}

/* Size grid avec prix */
.size-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 6px;
  margin: 0;
}

.size-cell {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  padding: var(--space-3);
  border: var(--surface-border);
  border-radius: var(--control-radius);
  cursor: pointer;
  transition: border-color 0.15s, background 0.15s, box-shadow 0.15s, transform 0.15s;
  min-height: 72px;
  background: var(--color-white);
  box-shadow: none;
}
.size-cell:hover:not(.is-sold-out) {
  background: var(--color-gray-100);
  border-color: var(--color-black);
  color: var(--color-black);
  transform: none;
  box-shadow: none;
}
.size-cell:hover:not(.is-sold-out) .size-cell__dot--available {
  background: var(--color-black);
}
.size-cell.is-selected {
  background: var(--color-black);
  border-color: var(--color-black);
  color: var(--color-white);
  transform: none;
  box-shadow: none;
}
.size-cell.is-sold-out {
  opacity: 0.4;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}
.size-cell.is-sold-out::after {
  content: '';
  position: absolute;
  left: 8px; right: 8px;
  top: 50%;
  height: 1px;
  background: var(--color-gray-500);
}

.size-cell__dot {
  position: absolute;
  top: var(--space-2);
  right: var(--space-2);
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--color-gray-300);
}
.size-cell__dot--available { background: var(--color-black); }
.size-cell.is-selected .size-cell__dot--available { background: var(--color-white); }

.size-cell__size {
  font-weight: var(--font-weight-bold);
  font-size: 18px;
  line-height: 1;
}
.size-cell__prices {
  display: flex;
  align-items: baseline;
  gap: 5px;
  margin-top: 5px;
  line-height: 1;
}
.size-cell__compare,
.size-cell__price {
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  color: inherit;
  line-height: 1;
}
.size-cell__compare {
  color: var(--color-gray-500);
  text-decoration: line-through;
}
.size-cell.is-selected .size-cell__compare { color: rgba(255,255,255,0.6); }

/* Stock */
.pinfo__stock {
  font-size: var(--font-size-small);
  color: var(--color-gray-700);
}

/* Shipping pills */
.pinfo__shipping {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: var(--space-2);
  list-style: none;
  padding: 0;
  align-items: center;
  margin-top: var(--space-4);
}
.pinfo__shipping-option {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  min-height: 32px;
  font-size: var(--font-size-small);
  font-weight: var(--font-weight-semibold);
  border: 0;
  background: var(--color-gray-100);
  padding: 6px 13px;
  border: var(--surface-border);
  border-radius: var(--control-radius);
  width: fit-content;
}
.pinfo__shipping-option.is-muted {
  color: var(--color-gray-500);
  background: var(--color-gray-200);
  opacity: 0.75;
}
.pinfo__shipping-option.is-active {
  color: var(--color-black);
  background: var(--color-gray-100);
  opacity: 1;
}
.pinfo__shipping-option.has-tooltip {
  outline: none;
}
.pinfo__shipping-option.has-tooltip:focus-visible {
  box-shadow: 0 0 0 2px var(--color-white), 0 0 0 4px var(--color-black);
}
.ship-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  border: 1px solid var(--color-black);
  display: inline-block;
  flex: 0 0 auto;
}
.ship-dot--filled { background: var(--color-black); }
.pinfo__shipping-tooltip {
  position: absolute;
  left: 0;
  bottom: calc(100% + var(--space-3));
  z-index: 2;
  width: min(340px, calc(100vw - 40px));
  padding: var(--space-4);
  border: 1px solid var(--color-gray-200);
  border-radius: var(--surface-radius);
  background: var(--color-white);
  box-shadow: var(--surface-shadow);
  color: var(--color-black);
  font-size: var(--font-size-body);
  font-weight: var(--font-weight-medium);
  line-height: 1.2;
  opacity: 0;
  pointer-events: none;
  transform: translateY(var(--space-1));
  transition: opacity 0.15s, transform 0.15s;
}
.pinfo__shipping-option:hover .pinfo__shipping-tooltip,
.pinfo__shipping-option:focus .pinfo__shipping-tooltip,
.pinfo__shipping-option:focus-within .pinfo__shipping-tooltip {
  opacity: 1;
  transform: translateY(0);
}

/* Buy buttons */
.pinfo__buttons {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-3);
  margin-top: var(--space-4);
}
.pinfo__btn {
  width: 100%;
  min-height: 44px;
  padding: 8px 0;
  font-weight: var(--font-weight-semibold);
  border-radius: var(--control-radius);
  transition: background 0.18s ease, border-color 0.18s ease, color 0.18s ease, opacity 0.18s ease, transform 0.18s ease;
}
.pinfo__btn::after {
  display: none;
}
.pinfo__btn.btn--primary {
  background: var(--color-black);
  color: var(--color-white);
  border: 1px solid var(--color-black);
}
.pinfo__btn.btn--primary:hover,
.pinfo__btn.btn--primary:focus-visible {
  background: var(--color-black);
  color: var(--color-white);
  opacity: 0.82;
  transform: scale(0.985);
}
.pinfo__btn--pickup {
  background: transparent;
  color: var(--color-black);
  border: var(--surface-border);
}
.pinfo__btn--pickup:hover {
  background: transparent;
  color: var(--color-black);
  border-color: var(--color-gray-400);
  opacity: 1;
  transform: scale(0.985);
}
.pinfo__btn[disabled] {
  opacity: 0.5;
  cursor: not-allowed;
  transform: none;
}

/* Accordéons */
.pinfo__accordions {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-top: var(--space-4);
}
.acc {
  border: var(--surface-border);
  border-radius: var(--control-radius);
  overflow: hidden;
}
.acc__summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: var(--space-4);
  font-weight: var(--font-weight-semibold);
  font-size: var(--font-size-body);
  cursor: pointer;
  list-style: none;
}
.acc__summary::-webkit-details-marker { display: none; }
.acc__icon { display: flex; transition: transform 0.2s; }
.acc[open] .acc__icon { transform: rotate(180deg); }
.acc__content {
  padding: 0 var(--space-4) var(--space-4);
  color: var(--color-gray-700);
  font-size: var(--font-size-small);
  line-height: 1.7;
}

@media (max-width: 768px) {
  .pmain {
    padding-top: var(--surface-gap);
    padding-bottom: calc(198px + env(safe-area-inset-bottom));
  }

  .breadcrumb {
    padding-bottom: var(--space-3);
    font-size: var(--font-size-xs);
  }

  .pmain__layout {
    padding-top: 0;
  }

  .pgallery__main {
    aspect-ratio: 4 / 5;
    margin-left: 0;
    margin-right: 0;
  }

  .pgallery__main-img {
    padding: var(--space-10) var(--space-5) var(--space-16);
  }

  .pgallery__badge {
    top: var(--space-4);
