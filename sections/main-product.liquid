  };

  function normalizeDecimal(value) {
    var number = Number(value);
    if (!Number.isFinite(number)) return '';
    var rounded = Math.round(number * 10) / 10;
    return String(rounded).replace(/\.0$/, '');
  }

  function formatSize(value) {
    return String(value).replace('.', ',').replace(/,0$/, '');
  }

  function formatEuSize(value) {
    var normalized = normalizeDecimal(value);
    if (!usesThirdEuSizing) return formatSize(normalized || value);
    var numericValue = Number(normalized);
    if (!Number.isFinite(numericValue)) return formatSize(value);
    var whole = Math.floor(numericValue);
    var decimal = Math.round((numericValue - whole) * 10);
    if (decimal === 3) return whole + ' 1/3';
    if (decimal === 7) return whole + ' 2/3';
    return String(whole);
  }

  function addSizeAmount(value, amount) {
    var size = Number(value);
    if (!Number.isFinite(size)) return value;
    return normalizeDecimal(size + amount);
  }

  function normalizeSizeText(value) {
    return String(value || '')
      .toLowerCase()
      .replace(/,/g, '.')
      .replace(/\u00a0/g, ' ')
      .replace(/⅓/g, ' 1/3')
      .replace(/⅔/g, ' 2/3')
      .replace(/½/g, '.5')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function normalizeSizeKey(value) {
    var normalized = normalizeSizeText(value)
      .replace(/\beu\b|\beur\b|taille|size|pointure/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();

    var fraction = normalized.match(/(\d{2})\s*(1|2)\/3/);
    if (fraction) {
      return normalizeDecimal(Number(fraction[1]) + (fraction[2] === '1' ? 0.3 : 0.7));
    }

    var number = normalized.match(/\d{2}(?:\.\d+)?/);
    if (!number) return '';
    return normalizeDecimal(number[0]);
  }

  function findNearestEuKey(key) {
    if (!key) return '';
    if (sizeMap[key]) return key;
    var numericKey = Number(key);
    if (!Number.isFinite(numericKey)) return '';
    var nearest = '';
    var nearestDistance = Infinity;
    Object.keys(sizeMap).forEach(function (candidate) {
      var distance = Math.abs(Number(candidate) - numericKey);
      if (distance < nearestDistance) {
        nearest = candidate;
        nearestDistance = distance;
      }
    });
    return nearestDistance <= 0.06 ? nearest : '';
  }

  function findEuKeyByUnit(sourceUnit, sourceValue) {
    var normalizedValue = normalizeDecimal(sourceValue);
    if (!normalizedValue) return '';

    if (sourceUnit === 'EU') {
      return findNearestEuKey(normalizedValue);
    }

    if (usesThirdEuSizing && sourceUnit === 'US' && thirdEuByUs[normalizedValue]) {
      return findNearestEuKey(thirdEuByUs[normalizedValue]) || thirdEuByUs[normalizedValue];
    }

    var matchedKeys = [];
    Object.keys(sizeMap).forEach(function (candidate) {
      var candidateValue = sizeMap[candidate][sourceUnit];
      if (!candidateValue) return;
      if (normalizeDecimal(String(candidateValue).replace(/[^\d.]/g, '')) === normalizedValue) {
        matchedKeys.push(candidate);
      }
    });
    if (!matchedKeys.length) return '';

    if (sourceUnit === 'US') {
      var preferredKeys = matchedKeys.filter(shouldShowGuideSize);
      if (preferredKeys.length) return preferredKeys[0];
    }

    return matchedKeys[0];
  }

  function parseSizeValue(value) {
    var normalized = normalizeSizeText(value);
    var sourceUnit = '';
    var sourceValue = '';
    var unitBefore = normalized.match(/\b(eu|eur|us(?:\s*[mwy])?|uk|cm|jp)\s*(\d+(?:\.\d+)?(?:\s*(?:1|2)\/3)?)/);
    var unitAfter = normalized.match(/(\d+(?:\.\d+)?(?:\s*(?:1|2)\/3)?)\s*(eu|eur|us(?:\s*[mwy])?|uk|cm|jp)\b/);
    var match = unitBefore || unitAfter;

    if (match) {
      sourceUnit = (unitBefore ? match[1] : match[2]).toUpperCase().replace(/\s+/g, '');
      sourceValue = unitBefore ? match[2] : match[1];
      if (sourceUnit === 'EUR') sourceUnit = 'EU';
      if (sourceUnit === 'USM' || sourceUnit === 'USW' || sourceUnit === 'USY') sourceUnit = 'US';
      if (sourceUnit === 'JP') sourceUnit = 'CM';
    }

    if (!sourceValue) {
      var fraction = normalized.match(/(\d+)\s*(1|2)\/3/);
      if (fraction) {
        sourceValue = normalizeDecimal(Number(fraction[1]) + (fraction[2] === '1' ? 0.3 : 0.7));
      } else {
        var number = normalized.match(/\d+(?:\.\d+)?/);
        sourceValue = number ? number[0] : '';
      }
    }

    if (!sourceUnit && sourceValue) {
      var numericValue = Number(sourceValue);
      sourceUnit = numericValue >= 30 ? 'EU' : 'US';
    }

    return {
      unit: sourceUnit,
      value: sourceValue,
      euKey: findEuKeyByUnit(sourceUnit, sourceValue)
    };
  }

  function getConvertedSize(rawSize, unit) {
    var parsed = parseSizeValue(rawSize);
    var key = parsed.euKey || findNearestEuKey(normalizeSizeKey(rawSize));
    var converted = '';

    if (unit === 'EU') {
      converted = key || (parsed.unit === 'EU' ? parsed.value : '');
    } else if (key && sizeMap[key] && sizeMap[key][unit]) {
      converted = sizeMap[key][unit];
    }

    if (!converted && key) {
      var numericKey = Number(key);
      Object.keys(sizeMap).some(function (candidate) {
        if (Math.abs(Number(candidate) - numericKey) <= 0.06 && sizeMap[candidate][unit]) {
          converted = sizeMap[candidate][unit];
          return true;
        }
        return false;
      });
    }

    if (unit === 'US' && converted && sizeProfile === 'women') {
      converted = addSizeAmount(converted, 1.5);
    }
    if (unit === 'US' && converted && sizeProfile === 'gs') {
      converted = converted + 'Y';
    }

    if (unit === 'EU' && converted) {
      return formatEuSize(converted);
    }

    return converted ? formatSize(converted) : rawSize;
  }

  function formatSizeWithUnit(rawSize, unit) {
    var convertedSize = getConvertedSize(rawSize, unit);
    if (unit === 'EU') return unit + ' ' + convertedSize;
    if (unit === 'US') return convertedSize + ' US M';
    return convertedSize + ' ' + unit;
  }

  function formatGuideValue(value) {
    return String(value || '').replace(',', '.');
  }

  function shouldShowGuideSize(key) {
    var numericKey = Number(key);
    if (!Number.isFinite(numericKey)) return false;
    var decimal = Math.round((numericKey - Math.floor(numericKey)) * 10);
    return usesThirdEuSizing ? decimal === 0 || decimal === 3 || decimal === 7 : decimal === 0 || decimal === 5;
  }

  function populateSizeGuide() {
    if (!sizeGuideBody) return;
    sizeGuideBody.innerHTML = '';
    Object.keys(sizeMap)
      .filter(shouldShowGuideSize)
      .sort(function (a, b) { return Number(a) - Number(b); })
      .forEach(function (key) {
        var row = document.createElement('tr');
        ['EU', 'US', 'UK', 'CM'].forEach(function (unit) {
          var cell = document.createElement('td');
          cell.textContent = formatGuideValue(getConvertedSize(key, unit));
          row.appendChild(cell);
        });
        sizeGuideBody.appendChild(row);
      });
  }

  function updateSizeUnit(unit) {
    sizeLabels.forEach(function (label) {
      var sourceSize = label.getAttribute('data-size-source') || label.dataset.sizeSource || label.textContent.trim();
      label.dataset.sizeSource = sourceSize;
      label.dataset.sizeKey = normalizeSizeKey(sourceSize);
      label.textContent = formatSizeWithUnit(sourceSize, unit);
    });
  }

  populateSizeGuide();
  updateSizeUnit('EU');

  unitBtns.forEach(function (b) {
    b.addEventListener('click', function (event) {
      event.preventDefault();
      unitBtns.forEach(function (x) { x.classList.remove('is-active'); });
      b.classList.add('is-active');
      unitBtns.forEach(function (x) { x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
      updateSizeUnit(b.dataset.unit || 'EU');
    });
  });

})();
